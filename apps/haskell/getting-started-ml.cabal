cabal-version:      2.4
name:               getting-started-ml
version:            0.1.0.0
synopsis:           「機械学習から始めるプログラミング入門」Haskell 版のサンプル実装
license:            MIT
build-type:         Simple

common warnings
    -- 網羅していないパターンマッチを、テストではなくコンパイルで捕まえる。
    ghc-options: -Wall -Werror

library
    import:           warnings
    exposed-modules:  GettingStartedMl.Chapter01
                    , GettingStartedMl.Chapter02
                    , GettingStartedMl.Chapter07
                    , GettingStartedMl.Chapter08
                    , GettingStartedMl.Chapter03
                    , GettingStartedMl.Chapter09
                    , GettingStartedMl.Chapter10
                    , GettingStartedMl.Chapter11
                    , GettingStartedMl.Chapter12
                    , GettingStartedMl.Chapter13
                    , GettingStartedMl.Chapter14
                    , GettingStartedMl.Chapter15
                    , GettingStartedMl.Chapter15.Api
                    , GettingStartedMl.Chapter15.Domain
                    , GettingStartedMl.Chapter15.FileStore
                    , GettingStartedMl.Chapter15.Service
                    , GettingStartedMl.Chapter15.Store
                    , GettingStartedMl.Chapter15.Validation
                    , GettingStartedMl.Csv
                    , GettingStartedMl.Dataset
                    , GettingStartedMl.Random
    hs-source-dirs:   src
    build-depends:    base >=4.17 && <5
                    , aeson
                    , binary
                    , bytestring
                    , cassava
                    , containers
                    , directory
                    , filepath
                    , hmatrix
                    , http-types
                    , scientific
                    , scotty
                    , warp
                    , statistics
                    , text
                    , unordered-containers
                    , vector
                    , wai
    default-language: Haskell2010

test-suite spec
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:    GettingStartedMl.Chapter01Spec
                    , GettingStartedMl.Chapter02Spec
                    , GettingStartedMl.Chapter07Spec
                    , GettingStartedMl.Chapter08Spec
                    , GettingStartedMl.Chapter03Spec
                    , GettingStartedMl.Chapter09Spec
                    , GettingStartedMl.Chapter10Spec
                    , GettingStartedMl.Chapter11Spec
                    , GettingStartedMl.Chapter12Spec
                    , GettingStartedMl.Chapter13Spec
                    , GettingStartedMl.Chapter14Spec
                    , GettingStartedMl.Chapter15Spec
                    , GettingStartedMl.CsvSpec
                    , GettingStartedMl.DatasetSpec
                    , GettingStartedMl.RandomSpec
    hs-source-dirs:   test
    build-depends:    base
                    , getting-started-ml
                    , hspec
                    , aeson
                    , bytestring
                    , statistics
                    , cassava
                    , containers
                    , text
                    , vector
                    , directory
                    , filepath
                    , hmatrix
                    , http-types
                    , scientific
                    , scotty
                    , wai
    build-tool-depends: hspec-discover:hspec-discover
    default-language: Haskell2010
