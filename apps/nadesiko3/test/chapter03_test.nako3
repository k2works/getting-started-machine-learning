# 名前の順に足すと 0.46666666666666673 と 0.4666666666666666 が入れ替わり、選ばれる分割が変わる例（第 10 章）。
順依存特徴量 = [{"p": 4, "q": 3}, {"p": 4, "q": 1}, {"p": 4, "q": 3}, {"p": 4, "q": 4}, {"p": 2, "q": 4}, {"p": 4, "q": 2}]
順依存正解 = [「b」, 「c」, 「a」, 「a」, 「c」, 「a」]
