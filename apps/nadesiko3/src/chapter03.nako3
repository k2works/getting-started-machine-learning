# 第 3 章: 決定木による分類。
#
# なでしこ3 には決定木のライブラリが無いので、ここで作る木がそのまま最終実装になる。
#
# 木は辞書で表す。葉は {"種別": 「葉」, "ラベル": …}、節は
# {"種別": 「節」, "分割": {"特徴量", "境界", "不純度"}, "左": 木, "右": 木}。
# 特徴量の値が境界以下なら左、境界より大きければ右へ進む。
# 型の検査が無いので、「種別」を見て場合分けする。場合分けの漏れはテストで捕まえる。

!「./chapter01.nako3」を取り込む
!「./chapter02.nako3」を取り込む
!「./number_format.nako3」を取り込む

# アヤメのデータの特徴量の列。正解ラベルの列を除いた順。
アヤメ特徴量列 = [「がく片長さ」, 「がく片幅」, 「花弁長さ」, 「花弁幅」]

# 表に載せる深さの並び。NULL は上限なし。
深さ一覧 = [1, 2, 3, 4, 5, NULL]

# ラベルごとの件数を、最初に現れた順の辞書で返す。
●(ラベル一覧の)ラベル計数とは
    件数一覧 = {}
    Iを 0から (ラベル一覧の要素数) - 1まで繰り返す
        ラベル = ラベル一覧[I]
        もし、(件数一覧のラベルがハッシュキー存在)ならば
            件数一覧[ラベル] = 件数一覧[ラベル] + 1
        違えば
            件数一覧[ラベル] = 1
        ここまで
    ここまで
    件数一覧で戻る
ここまで

# ジニ不純度。ラベルが 1 種類なら 0 で、種類が多く均等なほど大きい。
●(ラベル一覧の)ジニ不純度とは
    総数 = ラベル一覧の要素数
    もし、総数 = 0ならば
        0で戻る
    ここまで
    件数一覧 = ラベル一覧のラベル計数
    キー一覧 = 件数一覧のハッシュキー列挙
    二乗和 = 0
    Iを 0から (キー一覧の要素数) - 1まで繰り返す
        割合 = 件数一覧[キー一覧[I]] ÷ 総数
        二乗和 = 二乗和 + 割合 × 割合
    ここまで
    1 - 二乗和で戻る
ここまで

# いちばん多いラベルを返す。同数なら先に現れたほうを選ぶ。
●(ラベル一覧の)多数決とは
    もし、(ラベル一覧の要素数) = 0ならば
        「正解ラベルがありません」のエラー発生
    ここまで
    件数一覧 = ラベル一覧のラベル計数
    キー一覧 = 件数一覧のハッシュキー列挙
    最多 = キー一覧[0]
    Iを 1から (キー一覧の要素数) - 1まで繰り返す
        もし、件数一覧[キー一覧[I]] > 件数一覧[最多]ならば
            最多 = キー一覧[I]
        ここまで
    ここまで
    最多で戻る
ここまで

# 特徴量から列の値を読む。列が無ければエラーを起こす。
●(特徴量の列名を)特徴量値取得とは
    もし、(特徴量の列名がハッシュキー存在) = 偽ならば
        「列がありません: {列名}」のエラー発生
    ここまで
    特徴量[列名]で戻る
ここまで

# 左右のジニ不純度を件数で重み付けして平均する。
●(左ラベル一覧と右ラベル一覧の)重み付き不純度とは
    左件数 = 左ラベル一覧の要素数
    右件数 = 右ラベル一覧の要素数
    (左件数 × (左ラベル一覧のジニ不純度) + 右件数 × (右ラベル一覧のジニ不純度)) ÷ (左件数 + 右件数)で戻る
ここまで

# 配列の始点から終点の手前までを取り出した新しい配列を返す。
# 引数を「終了」と名付けると、プロセスを終わらせる命令「終了」が呼ばれ、
# エラーも出さずに終了コード 0 でプログラム全体が止まる。
●(配列の始点から終点まで)部分配列取得とは
    結果 = []
    Iを 始点から 終点 - 1まで繰り返す
        結果に配列[I]を配列追加
    ここまで
    結果で戻る
ここまで

# ラベルの番号ごとの件数（配列）と、足す順に並べた番号から、ジニ不純度を求める。
# 足す順を「その部分で最初に現れた順」にすれば、ジニ不純度 と最後の桁まで同じ値になる。
●(件数表と番号順と総数の)件数集計ジニ不純度とは
    二乗和 = 0
    Iを 0から (番号順の要素数) - 1まで繰り返す
        割合 = 件数表[番号順[I]] ÷ 総数
        二乗和 = 二乗和 + 割合 × 割合
    ここまで
    1 - 二乗和で戻る
ここまで

# 1 つの列で、隣り合う値の中点を境界にした分割の候補を、境界の小さい順に返す。
# 表数値ソート は安定なので、同じ値の並びは元の順のまま（元の表を書き換えるので複製してから並べる）。
#
# 候補ごとに左右の部分配列を作ってジニ不純度を数え直すと、命令の数が件数の 2 乗で増え、
# gonako の命令数の上限（1 回の実行で 2 億）に届く。そこで、境界を 1 つずつ右へずらしながら、
# 左右のラベルの件数を 1 件ずつ移して数え上げる。件数は整数なので、数え直しても数え上げても同じ値になる。
# 二乗を足す順は、左右それぞれ「その部分で最初に現れた順」のまま保つ（ジニ不純度 と同じ順）。
●(特徴量一覧と正解一覧の列名で)分割候補列挙とは
    組一覧 = []
    Iを 0から (特徴量一覧の要素数) - 1まで繰り返す
        組一覧に[(特徴量一覧[I]の列名を特徴量値取得), 正解一覧[I]]を配列追加
    ここまで
    組一覧の0を表数値ソート
    件数 = 組一覧の要素数
    # ラベルに、並べた順で現れた順に 0 から番号を振る。
    番号表 = {}
    番号列 = []
    種類数 = 0
    Iを 0から 件数 - 1まで繰り返す
        ラベル = 組一覧[I][1]
        もし、(番号表のラベルがハッシュキー存在) = 偽ならば
            番号表[ラベル] = 種類数
            種類数 = 種類数 + 1
        ここまで
        番号列に番号表[ラベル]を配列追加
    ここまで
    # 右側は最初すべての件数を持つ。同じラベルが次に現れる位置を後ろから求めておく。
    左件数 = []
    右件数 = []
    右先頭 = []
    右順 = []
    Iを 0から 種類数 - 1まで繰り返す
        左件数に0を配列追加
        右件数に0を配列追加
        右先頭に件数を配列追加
        右順にIを配列追加
    ここまで
    次位置 = []
    Iを 0から 件数 - 1まで繰り返す
        次位置に件数を配列追加
        右件数[番号列[I]] = 右件数[番号列[I]] + 1
    ここまで
    位置 = 件数 - 1
    (位置 ≧ 0)の間
        番号 = 番号列[位置]
        次位置[位置] = 右先頭[番号]
        右先頭[番号] = 位置
        位置 = 位置 - 1
    ここまで
    左順 = []
    候補一覧 = []
    Iを 1から 件数 - 1まで繰り返す
        # I - 1 番目を右から左へ移す。
        番号 = 番号列[I - 1]
        もし、左件数[番号] = 0ならば
            左順に番号を配列追加
        ここまで
        左件数[番号] = 左件数[番号] + 1
        右件数[番号] = 右件数[番号] - 1
        # 移した要素は右側の先頭だったので、そのラベルは右の順の先頭にある。
        # 次に現れる位置へ並べ直す（もう現れなければ右の順から外す）。
        右順の0を配列削除
        次先頭 = 次位置[I - 1]
        右先頭[番号] = 次先頭
        もし、次先頭 < 件数ならば
            挿入位置 = 右順の要素数
            Jを 0から (右順の要素数) - 1まで繰り返す
                もし、右先頭[右順[J]] > 次先頭ならば
                    挿入位置 = J
                    抜ける
                ここまで
            ここまで
            右順の挿入位置に番号を配列挿入
        ここまで
        前値 = 組一覧[I - 1][0]
        後値 = 組一覧[I][0]
        もし、前値 ≠ 後値ならば
            右総数 = 件数 - I
            左不純度 = 左件数と左順とIの件数集計ジニ不純度
            右不純度 = 右件数と右順と右総数の件数集計ジニ不純度
            不純度 = (I × 左不純度 + 右総数 × 右不純度) ÷ (I + 右総数)
            候補一覧に{"特徴量": 列名, "境界": (前値 + 後値) ÷ 2, "不純度": 不純度}を配列追加
        ここまで
    ここまで
    候補一覧で戻る
ここまで

# 左右の不純度の重み付き平均が最も小さくなる分割を返す。分けられなければ NULL を返す。
# 同じ不純度なら先に見つけた（列の順で前、境界の小さい）分割を選ぶ。
●(特徴量一覧と正解一覧を列名一覧で)最良分割探索とは
    もし、(特徴量一覧の要素数) = 0ならば
        NULLで戻る
    ここまで
    もし、(正解一覧のジニ不純度) = 0ならば
        NULLで戻る
    ここまで
    最良 = NULL
    Iを 0から (列名一覧の要素数) - 1まで繰り返す
        候補一覧 = 特徴量一覧と正解一覧の(列名一覧[I])で分割候補列挙
        Jを 0から (候補一覧の要素数) - 1まで繰り返す
            候補 = 候補一覧[J]
            もし、最良 === NULLならば
                最良 = 候補
            違えば、もし、候補["不純度"] < 最良["不純度"]ならば
                最良 = 候補
            ここまで
        ここまで
    ここまで
    最良で戻る
ここまで

# 深さの上限まで分割を繰り返して木を作る。深さ上限 が NULL なら上限なし。
●(特徴量一覧と正解一覧を列名一覧と深さ上限で)決定木学習とは
    もし、(特徴量一覧の要素数) ≠ (正解一覧の要素数)ならば
        「特徴量と正解ラベルの件数が違います: {特徴量一覧の要素数} と {正解一覧の要素数}」のエラー発生
    ここまで
    分割 = NULL
    もし、深さ上限 ≠ 0ならば
        分割 = 特徴量一覧と正解一覧を列名一覧で最良分割探索
    ここまで
    もし、分割 === NULLならば
        {"種別": 「葉」, "ラベル": 正解一覧の多数決}で戻る
    ここまで
    左特徴量 = []
    左正解 = []
    右特徴量 = []
    右正解 = []
    Iを 0から (特徴量一覧の要素数) - 1まで繰り返す
        値 = 特徴量一覧[I]の(分割["特徴量"])を特徴量値取得
        もし、値 ≦ 分割["境界"]ならば
            左特徴量に特徴量一覧[I]を配列追加
            左正解に正解一覧[I]を配列追加
        違えば
            右特徴量に特徴量一覧[I]を配列追加
            右正解に正解一覧[I]を配列追加
        ここまで
    ここまで
    次深さ = NULL
    もし、深さ上限 !== NULLならば
        次深さ = 深さ上限 - 1
    ここまで
    左木 = 左特徴量と左正解を列名一覧と次深さで決定木学習
    右木 = 右特徴量と右正解を列名一覧と次深さで決定木学習
    {"種別": 「節」, "分割": 分割, "左": 左木, "右": 右木}で戻る
ここまで

# 木をたどって 1 件のラベルを予測する。
●(木で特徴量を)一件予測とは
    節 = 木
    (節["種別"] = 「節」)の間
        分割 = 節["分割"]
        もし、(特徴量の(分割["特徴量"])を特徴量値取得) ≦ 分割["境界"]ならば
            節 = 節["左"]
        違えば
            節 = 節["右"]
        ここまで
    ここまで
    節["ラベル"]で戻る
ここまで

# 特徴量ごとのラベルを予測する。
●(木で特徴量一覧を)決定木予測とは
    予測一覧 = []
    Iを 0から (特徴量一覧の要素数) - 1まで繰り返す
        予測一覧に(木で特徴量一覧[I]を一件予測)を配列追加
    ここまで
    予測一覧で戻る
ここまで

# 木の予測と正解ラベルの一致率を返す。第 1 章の 正解率 をそのまま使う。
●(木で特徴量一覧と正解一覧の)決定木正解率とは
    (木で特徴量一覧を決定木予測)と正解一覧の正解率で戻る
ここまで

# 木を字下げ付きの文字列にする。
●(木を字下げで)決定木字下げ表示とは
    もし、木["種別"] = 「葉」ならば
        「{字下げ}{木["ラベル"]}{改行}」で戻る
    ここまで
    分割 = 木["分割"]
    列名 = 分割["特徴量"]
    境界表示 = (分割["境界"])を4で小数表示
    次字下げ = 字下げ & 「  」
    左表示 = (木["左"])を次字下げで決定木字下げ表示
    右表示 = (木["右"])を次字下げで決定木字下げ表示
    「{字下げ}{列名} <= {境界表示}{改行}{左表示}{字下げ}{列名} > {境界表示}{改行}{右表示}」で戻る
ここまで

# 木を字下げ付きの文字列にする（字下げなしから始める）。
●(木を)決定木表示とは
    木を「」で決定木字下げ表示で戻る
ここまで

# 読み込んだ中身から、深さごとの正解率と深さ 2 の決定木の報告を作る。テストで確かめられる。
●(CSV文字列を)決定木報告作成とは
    分割結果 = CSV文字列を0.3と0でアヤメ前処理
    訓練特徴量 = 分割結果["訓練特徴量"]
    訓練正解 = 分割結果["訓練正解"]
    テスト特徴量 = 分割結果["テスト特徴量"]
    テスト正解 = 分割結果["テスト正解"]
    報告 = 「深さ{タブ}訓練データ{タブ}テストデータ{改行}」
    Iを 0から (深さ一覧の要素数) - 1まで繰り返す
        深さ = 深さ一覧[I]
        学習木 = 訓練特徴量と訓練正解をアヤメ特徴量列と深さで決定木学習
        訓練表示 = (学習木で訓練特徴量と訓練正解の決定木正解率)を4で小数表示
        テスト表示 = (学習木でテスト特徴量とテスト正解の決定木正解率)を4で小数表示
        深さ表示 = 「制限なし」
        もし、深さ !== NULLならば
            深さ表示 = 「{深さ}」
        ここまで
        報告 = 報告 & 「{深さ表示}{タブ}{訓練表示}{タブ}{テスト表示}{改行}」
    ここまで
    深さ二木 = 訓練特徴量と訓練正解をアヤメ特徴量列と2で決定木学習
    報告 & 「{改行}深さ 2 の決定木:{改行}」 & (深さ二木を決定木表示)で戻る
ここまで

