# 第 12 章: 正則化とモデル選択。
#
# リッジ回帰を第 7 章の正規方程式に 1 項足して自作し、linear_algebra.nako3 の
# 連立一次方程式求解 で解く。ラッソ回帰は座標降下法で自作する。なでしこ3 には線形代数の
# ライブラリも機械学習のライブラリも無いので、どちらも自作がそのまま最終実装になり、
# 突き合わせる相手の代わりに性質（alpha が 0 なら第 7 章の線形回帰と一致する、解が
# 正規方程式や KKT 条件を満たす）をテストにする。
#
# 前処理は第 9 章の関数（標準化器学習・標準化器適用・多項式特徴量展開・多項式列名一覧作成・
# 住宅目的値変換）と第 2 章の 訓練テスト分割 をそのまま使い、新しく書くのは z スコアによる
# 外れ値の除去だけにする。モデルは第 7 章と同じ辞書 {"切片", "列名一覧", "係数一覧"}。

!「./chapter09.nako3」を取り込む

# 使う特徴量の列。2 次の項を作る順もこの並びで決まる（ほかの言語版と同じ）。
正則化特徴量列 = [「RM」, 「PTRATIO」, 「LSTAT」]
# z スコアの絶対値がこの値を超える値を持つ行を外れ値とする。
正則化外れ値閾値 = 3
# テストデータの割合、訓練用をさらに分けるときの検証データの割合、分割の乱数のシード。
正則化テスト割合 = 0.3
正則化検証割合 = 0.3
正則化乱数シード = 0
# 試す正則化の強さ。
正則化強度候補 = [0, 0.1, 1, 10, 100]
# ラッソ回帰の正則化の強さ。自作の目的関数は件数で割らないので、件数で割る実装
# （Java 版・Clojure 版が使う Tribuo）の alpha=0.5 は、訓練データ 47 件では 0.5 × 47 = 23.5 にあたる。
ラッソ強度 = 23.5
# 座標降下法の繰り返しの上限と、係数の動きがこれより小さくなったら打ち切る幅。
ラッソ反復上限 = 10000
ラッソ収束幅 = 0.0000000001
# alpha が 0 のリッジ回帰と第 7 章の線形回帰の係数の差が、これより小さければ一致とみなす。
係数差許容幅 = 0.000000001

# 小さな道具 -----------------------------------------------------------------

# 内積。左から順に掛けて足す。
●(左一覧と右一覧の)正則化内積算出とは
    総和 = 0
    Iを 0から (左一覧の要素数) - 1まで繰り返す
        総和 = 総和 + 左一覧[I] × 右一覧[I]
    ここまで
    総和で戻る
ここまで

# 平均。左から順に足してから件数で割る。
●(値一覧の)正則化平均算出とは
    総和 = 0
    Iを 0から (値一覧の要素数) - 1まで繰り返す
        総和 = 総和 + 値一覧[I]
    ここまで
    総和 ÷ (値一覧の要素数)で戻る
ここまで

# 件数を確かめ、列ごとの平均・正解の平均・平均を引いた列と正解を返す。
# リッジ回帰とラッソ回帰で同じ前準備をするので 1 か所にまとめる。
# 列（行列を転置したもの）で持つのは、どちらも列どうしの内積で計算するため。
●(特徴量一覧と正解一覧を列名一覧で)正則化問題中心化とは
    もし、(特徴量一覧の要素数) = 0ならば
        「訓練データが空です」のエラー発生
    ここまで
    もし、(特徴量一覧の要素数) ≠ (正解一覧の要素数)ならば
        「特徴量と正解の件数が違います: {特徴量一覧の要素数} と {正解一覧の要素数}」のエラー発生
    ここまで
    列一覧 = (特徴量一覧と列名一覧の特徴量行列変換)を行列転置
    平均一覧 = []
    中心化列一覧 = []
    Jを 0から (列一覧の要素数) - 1まで繰り返す
        平均 = (列一覧[J])の正則化平均算出
        新列 = []
        Iを 0から ((列一覧[J])の要素数) - 1まで繰り返す
            新列に(列一覧[J][I] - 平均)を配列追加
        ここまで
        平均一覧に平均を配列追加
        中心化列一覧に新列を配列追加
    ここまで
    正解平均 = 正解一覧の正則化平均算出
    中心化正解 = []
    Iを 0から (正解一覧の要素数) - 1まで繰り返す
        中心化正解に(正解一覧[I] - 正解平均)を配列追加
    ここまで
    {"平均一覧": 平均一覧, "正解平均": 正解平均, "中心化列一覧": 中心化列一覧, "中心化正解": 中心化正解}で戻る
ここまで

# 中心化した問題の重みから、第 7 章と同じ形のモデルを作る。
# 切片は、正解の平均から「列の平均 × 係数」の合計を引いた値。
●(問題と列名一覧を重み一覧で)正則化モデル作成とは
    切片 = 問題["正解平均"] - ((問題["平均一覧"])と重み一覧の正則化内積算出)
    切片と列名一覧を重み一覧で線形回帰モデル作成して戻る
ここまで

# リッジ回帰 -----------------------------------------------------------------

# 平均を引いてから (Xᵀ X + alpha I) w = Xᵀ t を解いて係数を求める。
# 平均を引くのは切片に罰則をかけないため。alpha が 0 なら第 7 章の線形回帰と同じ解になる。
●(特徴量一覧と正解一覧を列名一覧と強度で)リッジ回帰学習とは
    問題 = 特徴量一覧と正解一覧を列名一覧で正則化問題中心化
    列一覧 = 問題["中心化列一覧"]
    正規行列 = []
    右辺一覧 = []
    Iを 0から (列一覧の要素数) - 1まで繰り返す
        行 = []
        Jを 0から (列一覧の要素数) - 1まで繰り返す
            値 = (列一覧[I])と(列一覧[J])の正則化内積算出
            # 対角に alpha を足す。切片は中心化で外してあるので、罰則は係数だけにかかる。
            もし、I = Jならば
                値 = 値 + 強度
            ここまで
            行に値を配列追加
        ここまで
        正規行列に行を配列追加
        右辺一覧に((列一覧[I])と(問題["中心化正解"])の正則化内積算出)を配列追加
    ここまで
    重み一覧 = 正規行列と右辺一覧を連立一次方程式求解
    問題と列名一覧を重み一覧で正則化モデル作成して戻る
ここまで

# ラッソ回帰 -----------------------------------------------------------------

# 軟しきい値作用素。値の絶対値がしきい値以下なら 0 にし、そうでなければ 0 のほうへ縮める。
●(値と閾値の)軟閾値算出とは
    もし、値 > 閾値ならば
        値 - 閾値で戻る
    ここまで
    もし、値 < (0 - 閾値)ならば
        値 + 閾値で戻る
    ここまで
    0で戻る
ここまで

# 平均を引いてから、座標降下法で ½‖t − Xw‖² + alpha ‖w‖₁ を最小にする。
#
# L1 の罰則は原点で折れているので、行列を解いて終わりにはできない。係数を 1 つずつ順に動かし、
# 軟しきい値で 0 に寄せる。1 巡ですべての係数を動かし、いちばん大きな動きが収束幅より
# 小さくなるか、上限の巡回数に達したら打ち切る（Haskell 版と同じ打ち切り条件と更新の順）。
●(特徴量一覧と正解一覧を列名一覧と強度で)ラッソ回帰学習とは
    問題 = 特徴量一覧と正解一覧を列名一覧で正則化問題中心化
    列一覧 = 問題["中心化列一覧"]
    二乗和一覧 = []
    重み一覧 = []
    Jを 0から (列一覧の要素数) - 1まで繰り返す
        二乗和一覧に((列一覧[J])と(列一覧[J])の正則化内積算出)を配列追加
        重み一覧に0を配列追加
    ここまで
    残差一覧 = (問題["中心化正解"])を配列複製
    件数 = 残差一覧の要素数
    周数 = 0
    (周数 < ラッソ反復上限)の間
        最大変化 = 0
        Jを 0から (列一覧の要素数) - 1まで繰り返す
            # 値がすべて同じ列は動かしようがないので 0 のままにする（0 で割らない）。
            もし、(二乗和一覧[J]) = 0ならば
                続ける
            ここまで
            現列 = 列一覧[J]
            旧値 = 重み一覧[J]
            # いったん列の寄与を残差に戻してから、残差との相関で係数を決め直す。
            復元一覧 = []
            Iを 0から 件数 - 1まで繰り返す
                復元一覧に(残差一覧[I] + 旧値 × 現列[I])を配列追加
            ここまで
            新値 = ((現列と復元一覧の正則化内積算出)と強度の軟閾値算出) ÷ 二乗和一覧[J]
            残差一覧 = []
            Iを 0から 件数 - 1まで繰り返す
                残差一覧に(復元一覧[I] - 新値 × 現列[I])を配列追加
            ここまで
            重み一覧[J] = 新値
            変化 = (新値 - 旧値)の絶対値
            もし、変化 > 最大変化ならば
                最大変化 = 変化
            ここまで
        ここまで
        周数 = 周数 + 1
        もし、最大変化 < ラッソ収束幅ならば
            抜ける
        ここまで
    ここまで
    問題と列名一覧を重み一覧で正則化モデル作成して戻る
ここまで

# 係数を読む -----------------------------------------------------------------

# 係数の絶対値の合計。正則化が強いほど小さくなる。
●(モデルの)係数絶対値合計算出とは
    総和 = 0
    係数一覧 = モデル["係数一覧"]
    Iを 0から (係数一覧の要素数) - 1まで繰り返す
        総和 = 総和 + ((係数一覧[I])の絶対値)
    ここまで
    総和で戻る
ここまで

# 係数がちょうど 0 になった特徴量の名前を、列の順に返す。
# 軟しきい値が 0 そのものを返すので、「0 に近い」ではなく「0 である」を比べる。
●(モデルの)零係数列名抽出とは
    結果 = []
    列名一覧 = モデル["列名一覧"]
    Iを 0から (列名一覧の要素数) - 1まで繰り返す
        もし、モデル["係数一覧"][I] === 0ならば
            結果に(列名一覧[I])を配列追加
        ここまで
    ここまで
    結果で戻る
ここまで

# 実験の記録とモデル選択 -----------------------------------------------------

# alpha ごとにリッジ回帰を学習し、訓練データと検証データの決定係数と係数の絶対値の合計を記録する。
●(分割データと強度一覧の)リッジ実験実行とは
    訓練特徴量 = 分割データ["訓練特徴量"]
    訓練正解 = 分割データ["訓練正解"]
    列名一覧 = 分割データ["列名一覧"]
    結果 = []
    Iを 0から (強度一覧の要素数) - 1まで繰り返す
        モデル = 訓練特徴量と訓練正解を列名一覧と(強度一覧[I])でリッジ回帰学習
        訓練決定係数 = 訓練正解と(モデルで訓練特徴量を線形回帰予測)の決定係数算出
        検証決定係数 = (分割データ["検証正解"])と(モデルで(分割データ["検証特徴量"])を線形回帰予測)の決定係数算出
        結果に{"強度": 強度一覧[I], "訓練決定係数": 訓練決定係数, "検証決定係数": 検証決定係数, "係数絶対値合計": モデルの係数絶対値合計算出}を配列追加
    ここまで
    結果で戻る
ここまで

# 検証データの決定係数が最も高い実験を返す。同じ値なら先の実験（小さい alpha）を選ぶので、
# 厳密に大きいときだけ入れ替える。
●(実験一覧の)最良実験選択とは
    もし、(実験一覧の要素数) = 0ならば
        「実験結果が 1 件もありません」のエラー発生
    ここまで
    最良 = 実験一覧[0]
    Iを 1から (実験一覧の要素数) - 1まで繰り返す
        もし、(実験一覧[I]["検証決定係数"]) > (最良["検証決定係数"])ならば
            最良 = 実験一覧[I]
        ここまで
    ここまで
    最良で戻る
ここまで

# 外れ値と前処理 -------------------------------------------------------------

# 列ごとの z スコアの絶対値が閾値を超える値を 1 つでも持つ行を除いた新しい表を返す。
# 標準偏差は件数 n − 1 で割る標本標準偏差を使う（第 9 章の標準化の n とは違う）。
# n 件のデータの z スコアには (n − 1) ÷ √n という上限があるので、件数が少ないと閾値 3 には届かない。
●(対象表と列名一覧を閾値で)標準得点外れ値除去とは
    行一覧 = 対象表["行一覧"]
    統計一覧 = []
    Jを 0から (列名一覧の要素数) - 1まで繰り返す
        列名 = 列名一覧[J]
        値一覧 = []
        Iを 0から (行一覧の要素数) - 1まで繰り返す
            値 = 行一覧[I]の列名を欠損許容数値取得
            もし、値 === NULLならば
                「値が空欄です: {列名}」のエラー発生
            ここまで
            値一覧に値を配列追加
        ここまで
        もし、(値一覧の要素数) < 2ならば
            「外れ値を判定するには 2 件以上が要ります: {列名}」のエラー発生
        ここまで
        平均 = 値一覧の正則化平均算出
        二乗和 = 0
        Iを 0から (値一覧の要素数) - 1まで繰り返す
            偏差 = 値一覧[I] - 平均
            二乗和 = 二乗和 + 偏差 × 偏差
        ここまで
        統計一覧に[値一覧, 平均, (二乗和 ÷ ((値一覧の要素数) - 1))の平方根]を配列追加
    ここまで
    残す行一覧 = []
    Iを 0から (行一覧の要素数) - 1まで繰り返す
        外れ = 偽
        Jを 0から (統計一覧の要素数) - 1まで繰り返す
            統計 = 統計一覧[J]
            もし、(統計[2] ≠ 0)かつ((((統計[0][I] - 統計[1]) ÷ 統計[2])の絶対値) > 閾値)ならば
                外れ = 真
            ここまで
        ここまで
        もし、外れ = 偽ならば
            残す行一覧に(行一覧[I])を配列追加
        ここまで
    ここまで
    {"列名一覧": 対象表["列名一覧"], "行一覧": 残す行一覧}で戻る
ここまで

# 外れ値を除き、全体を訓練用とテスト用に、訓練用をさらに訓練データと検証データに分ける。
# 第 2 章の 訓練テスト分割 を 2 回呼ぶだけで 3 つに分けられる。内側の「テストデータ」が検証データになる。
# 標準化の平均と標準偏差は訓練データだけから求め、3 つとも同じ値で変換してから 2 次の項を作る。
●(CSV文字列を外側割合と内側割合とシードで)正則化住宅前処理とは
    除去表 = (CSV文字列を表読込)と[住宅目的列, 正則化特徴量列[0], 正則化特徴量列[1], 正則化特徴量列[2]]を正則化外れ値閾値で標準得点外れ値除去
    行一覧 = 除去表["行一覧"]
    特徴量一覧 = []
    ラベル一覧 = []
    Iを 0から (行一覧の要素数) - 1まで繰り返す
        特徴量 = {}
        Jを 0から (正則化特徴量列の要素数) - 1まで繰り返す
            特徴量[正則化特徴量列[J]] = 行一覧[I]の(正則化特徴量列[J])を欠損許容数値取得
        ここまで
        特徴量一覧に特徴量を配列追加
        ラベル一覧に(行一覧[I]の住宅目的列を列取得)を配列追加
    ここまで
    外側 = 特徴量一覧とラベル一覧を外側割合とシードで訓練テスト分割
    内側 = (外側["訓練特徴量"])と(外側["訓練正解"])を内側割合とシードで訓練テスト分割
    標準化器 = (内側["訓練特徴量"])と正則化特徴量列で標準化器学習
    {"訓練特徴量": (標準化器で(内側["訓練特徴量"])を標準化器適用)と正則化特徴量列で多項式特徴量展開, "訓練正解": (内側["訓練正解"])の住宅目的値変換, "検証特徴量": (標準化器で(内側["テスト特徴量"])を標準化器適用)と正則化特徴量列で多項式特徴量展開, "検証正解": (内側["テスト正解"])の住宅目的値変換, "テスト特徴量": (標準化器で(外側["テスト特徴量"])を標準化器適用)と正則化特徴量列で多項式特徴量展開, "テスト正解": (外側["テスト正解"])の住宅目的値変換, "列名一覧": 正則化特徴量列の多項式列名一覧作成, "残件数": 行一覧の要素数}で戻る
ここまで

# 指定した alpha のリッジ回帰を訓練データで学習し、テストデータの決定係数を返す。
●(分割データと強度の)正則化テスト決定係数算出とは
    モデル = (分割データ["訓練特徴量"])と(分割データ["訓練正解"])を(分割データ["列名一覧"])と強度でリッジ回帰学習
    (分割データ["テスト正解"])と(モデルで(分割データ["テスト特徴量"])を線形回帰予測)の決定係数算出して戻る
ここまで

# 報告 -----------------------------------------------------------------------

# 実験 1 件を表の 1 行にする。alpha は 5 文字の幅に右寄せする。
●(実験の)実験行表示とは
    強度表示 = ((実験["強度"])を1で小数表示)を5で空白埋
    「{強度表示}  {(実験["訓練決定係数"])を4で小数表示}  {(実験["検証決定係数"])を4で小数表示}  {(実験["係数絶対値合計"])を3で小数表示}」で戻る
ここまで

# 2 つのモデルの係数の差を表示する。許容幅より小さければ一致とみなして上限だけを示す。
●(係数差の)係数差表示とは
    もし、係数差 < 係数差許容幅ならば
        「1.0e-9 未満」で戻る
    ここまで
    係数差を12で小数表示して戻る
ここまで

# 2 つのモデルの係数の差のうち、いちばん大きいもの。
●(左モデルと右モデルの)係数最大差算出とは
    最大 = 0
    Iを 0から ((左モデル["係数一覧"])の要素数) - 1まで繰り返す
        差 = (左モデル["係数一覧"][I] - 右モデル["係数一覧"][I])の絶対値
        もし、差 > 最大ならば
            最大 = 差
        ここまで
    ここまで
    最大で戻る
ここまで

# 読み込んだ中身から報告の文字列を作る。ファイルを読まないので、テストで確かめられる。
●(CSV文字列の)正則化報告作成とは
    総件数 = ((CSV文字列を表読込)["行一覧"])の要素数
    分割データ = CSV文字列を正則化テスト割合と正則化検証割合と正則化乱数シードで正則化住宅前処理
    訓練特徴量 = 分割データ["訓練特徴量"]
    訓練正解 = 分割データ["訓練正解"]
    列名一覧 = 分割データ["列名一覧"]
    実験一覧 = 分割データと正則化強度候補のリッジ実験実行
    最良 = 実験一覧の最良実験選択
    行一覧 = []
    行一覧に「データ件数: {分割データ["残件数"]}（外れ値 {総件数 - 分割データ["残件数"]} 件を除外）」を配列追加
    行一覧に「訓練データ: {訓練正解の要素数} 件, 検証データ: {(分割データ["検証正解"])の要素数} 件, テストデータ: {(分割データ["テスト正解"])の要素数} 件」を配列追加
    行一覧に「特徴量: {列名一覧を『, 』で配列結合}」を配列追加
    行一覧に「alpha  訓練 R²  検証 R²  係数の絶対値の合計」を配列追加
    Iを 0から (実験一覧の要素数) - 1まで繰り返す
        行一覧に((実験一覧[I])の実験行表示)を配列追加
    ここまで
    行一覧に「検証データで選んだ alpha: {(最良["強度"])を1で小数表示}」を配列追加
    線形決定係数 = 分割データと0の正則化テスト決定係数算出
    リッジ決定係数 = 分割データと(最良["強度"])の正則化テスト決定係数算出
    行一覧に「テストデータの決定係数: 線形回帰 {線形決定係数を4で小数表示}, リッジ回帰 {リッジ決定係数を4で小数表示}」を配列追加
    零リッジ = 訓練特徴量と訓練正解を列名一覧と0でリッジ回帰学習
    最小二乗 = 訓練特徴量と訓練正解を列名一覧で線形回帰学習
    行一覧に「第 7 章の線形回帰との係数の最大の差（alpha=0.0）: {(零リッジと最小二乗の係数最大差算出)の係数差表示}」を配列追加
    ラッソ = 訓練特徴量と訓練正解を列名一覧とラッソ強度でラッソ回帰学習
    行一覧に「ラッソ回帰（alpha={ラッソ強度を1で小数表示}）で係数が 0 になった特徴量: {(ラッソの零係数列名抽出)を『, 』で配列結合}」を配列追加
    (行一覧を改行で配列結合) & 改行で戻る
ここまで

