# 第 1 章: 人間が決めたルールできのこ派・たけのこ派を判定する。

!「./csv.nako3」を取り込む
!「./dataset.nako3」を取り込む
!「./number_format.nako3」を取り込む

# 「20 代ならきのこ派」というルールの年代。
キノコ派年代 = 20

# 人間が決めたルールで派閥を判定する。特徴量は「身長」「体重」「年代」を持つ辞書。
●(特徴量を)ルール判定とは
    もし、特徴量["年代"] = キノコ派年代ならば
        「きのこ」で戻る
    ここまで
    「たけのこ」で戻る
ここまで

# 予測が正解ラベルと一致した割合を返す。件数が違うか、正解ラベルが無ければエラーを起こす。
●(予測と正解ラベルの)正解率とは
    予測件数 = 予測の要素数
    正解件数 = 正解ラベルの要素数
    もし、予測件数 ≠ 正解件数ならば
        「予測と正解ラベルの件数が違います: {予測件数} と {正解件数}」のエラー発生
    ここまで
    もし、正解件数 = 0ならば
        「正解ラベルがありません」のエラー発生
    ここまで
    当たり = 0
    Iを 0から 正解件数 - 1まで繰り返す
        もし、予測[I] = 正解ラベル[I]ならば
            当たり = 当たり + 1
        ここまで
    ここまで
    当たり ÷ 正解件数で戻る
ここまで

# 取りうる派閥の呼び名。
派閥一覧 = [「きのこ」, 「たけのこ」]

# CSV の文字列を読み、人物（身長・体重・年代・派閥の辞書）の配列にする。
# どれか 1 つでも読めなければエラーを起こす。
●(CSV文字列を)人物読込とは
    行一覧 = CSV文字列を列名付き読込
    人物一覧 = []
    Iを 0から (行一覧の要素数) - 1まで繰り返す
        行 = 行一覧[I]
        人物 = {}
        人物["身長"] = 行の「身長」を整数取得
        人物["体重"] = 行の「体重」を整数取得
        人物["年代"] = 行の「年代」を整数取得
        人物["派閥"] = 行の「派閥」を列取得して派閥検査
        人物一覧に人物を配列追加
    ここまで
    人物一覧で戻る
ここまで

# 知っている派閥ならそのまま返す。知らない値ならエラーを起こす。
●(呼び名を)派閥検査とは
    位置 = 派閥一覧から呼び名を配列検索
    もし、位置 < 0ならば
        「派閥を読めません: {呼び名}」のエラー発生
    ここまで
    呼び名で戻る
ここまで

# 人物の配列を、特徴量の配列と正解ラベルの配列に分けて辞書で返す。
●(人物一覧を)特徴量正解分離とは
    特徴量一覧 = []
    正解ラベル一覧 = []
    Iを 0から (人物一覧の要素数) - 1まで繰り返す
        人物 = 人物一覧[I]
        特徴量一覧に{"身長": 人物["身長"], "体重": 人物["体重"], "年代": 人物["年代"]}を配列追加
        正解ラベル一覧に人物["派閥"]を配列追加
    ここまで
    {"特徴量": 特徴量一覧, "正解ラベル": 正解ラベル一覧}で戻る
ここまで

# CSV の文字列から、データ件数とルールによる判定の正解率を報告する文字列を作る。
# ファイルを読まないので、テストで確かめられる。
●(CSV文字列を)判定報告作成とは
    人物一覧 = CSV文字列を人物読込
    分離結果 = 人物一覧を特徴量正解分離
    特徴量一覧 = 分離結果["特徴量"]
    予測一覧 = []
    Iを 0から (特徴量一覧の要素数) - 1まで繰り返す
        予測一覧に(特徴量一覧[I]をルール判定)を配列追加
    ここまで
    割合 = 予測一覧と(分離結果["正解ラベル"])の正解率
    件数 = 人物一覧の要素数
    割合表示 = 割合を4で小数表示
    「データ件数: {件数}{改行}ルールによる判定の正解率: {割合表示}{改行}」で戻る
ここまで

