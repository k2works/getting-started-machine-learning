# 第 10 章: ロジスティック回帰とアンサンブル学習。
#
# なでしこ3 には機械学習のライブラリが無いので、ロジスティック回帰もランダムフォレストも
# ここで作るものがそのまま最終実装になる。突き合わせる相手はほかの言語版の数値である。
#
# モデル共通の約束: なでしこ3 には型もインターフェースも無いので、モデルを
# {"名前": 表に載せる名前, "学習": 関数(特徴量一覧, 正解一覧, 列名一覧)} の辞書で表す。
# 「学習」は、学習を済ませて「予測する関数」（関数(特徴量一覧)）を返す。
# 約束を守っているかは誰も検査しないので、守りはテストだけである。

!「./chapter03.nako3」を取り込む

# 確率が 0 のときに LOG が負の無限大にならないように足す値。
交差エントロピー微小値 = 0.000000000001
# 森に作る木の数。
森木数既定 = 100
# 1 本の木に渡す特徴量の数。
森特徴量数既定 = 2
# 比べる決定木の深さ。
比較木深さ = 2
# 分割と森のシード。
比較乱数シード = 0

# ---- ソフトマックス関数と交差エントロピー ----

# スコアを、合計が 1 になる確率に変換する。
# 最大値を引いてから EXP を求めるので、大きな値でもあふれない（引いた分は分母と分子で打ち消し合う）。
# なでしこ3 の EXP は止まらずに Infinity を返すので、引き算を省くと Infinity ÷ Infinity で NaN になる。
●(スコア一覧の)ソフトマックス変換とは
    結果 = []
    件数 = スコア一覧の要素数
    もし、件数 = 0ならば
        結果で戻る
    ここまで
    最大 = スコア一覧[0]
    Iを 0から 件数 - 1まで繰り返す
        もし、スコア一覧[I] > 最大ならば
            最大 = スコア一覧[I]
        ここまで
    ここまで
    指数一覧 = []
    指数和 = 0
    Iを 0から 件数 - 1まで繰り返す
        指数 = (スコア一覧[I] - 最大)のEXP
        指数一覧に指数を配列追加
        指数和 = 指数和 + 指数
    ここまで
    Iを 0から 件数 - 1まで繰り返す
        結果に(指数一覧[I] ÷ 指数和)を配列追加
    ここまで
    結果で戻る
ここまで

# 交差エントロピー。正解の品種の確率の対数の平均に、マイナスを付けたもの。
# LOG は 0 で止まらずに -Infinity を返すので、ごく小さい値を足してから対数を取る。
●(確率一覧と正解番号一覧の)交差エントロピーとは
    件数 = 確率一覧の要素数
    もし、件数 = 0ならば
        0で戻る
    ここまで
    対数和 = 0
    Iを 0から 件数 - 1まで繰り返す
        確率 = 確率一覧[I][正解番号一覧[I]]
        対数和 = 対数和 + ((確率 + 交差エントロピー微小値)のLOG)
    ここまで
    0 - 対数和 ÷ 件数で戻る
ここまで

# ---- ロジスティック回帰 ----

# 正解ラベルから品種を重複なく取り出し、名前の順に並べた新しい配列を返す。
●(正解一覧の)品種整列とは
    既出 = {}
    品種一覧 = []
    Iを 0から (正解一覧の要素数) - 1まで繰り返す
        品種 = 正解一覧[I]
        もし、(既出の品種がハッシュキー存在) = 偽ならば
            既出[品種] = 真
            品種一覧に品種を配列追加
        ここまで
    ここまで
    品種一覧を配列ソート
    品種一覧で戻る
ここまで

# 行数 × 列数の、すべて 0 の表を返す。
●(行数と列数の)零行列作成とは
    結果 = []
    (行数)回
        行 = []
        (列数)回
            行に0を配列追加
        ここまで
        結果に行を配列追加
    ここまで
    結果で戻る
ここまで

# 1 行のスコア（品種ごと）。切片から始めて、特徴量を外、品種を内にして足し込む。
# 足し込む順をほかの言語版にそろえる（浮動小数点の足し算は順で最後の桁が変わる）。
●(行値一覧と重み一覧と切片一覧の)ロジスティック行スコアとは
    スコア = 切片一覧を配列複製
    Jを 0から (行値一覧の要素数) - 1まで繰り返す
        Kを 0から (スコアの要素数) - 1まで繰り返す
            スコア[K] = スコア[K] + 行値一覧[J] × 重み一覧[J][K]
        ここまで
    ここまで
    スコアで戻る
ここまで

# 特徴量の辞書から、列名一覧の順に値を読んだ配列を返す。列が無ければエラーを起こす。
●(特徴量を列名一覧で)行値抽出とは
    結果 = []
    Jを 0から (列名一覧の要素数) - 1まで繰り返す
        結果に(特徴量の(列名一覧[J])を特徴量値取得)を配列追加
    ここまで
    結果で戻る
ここまで

# 1 回の繰り返しのうち、全行のスコア・確率・損失・誤差を求める（品種の数によらない書き方）。
# 返すのは {"誤差表": 行ごとの 誤差（確率 − 正解）, "対数和": 正解の品種の確率の対数を行の順に足したもの}。
●(行一覧と正解番号一覧を重み転置と切片で)品種誤差計算とは
    品種数 = 切片の要素数
    列数 = 重み転置[0]の要素数
    対数和 = 0
    誤差表 = []
    Iを 0から (行一覧の要素数) - 1まで繰り返す
        行値 = 行一覧[I]
        # スコア（切片から始めて、特徴量の順に足す）。配列の要素ではなく変数に足し込む。
        スコア = []
        Kを 0から 品種数 - 1まで繰り返す
            重 = 重み転置[K]
            積和 = 切片[K]
            Jを 0から 列数 - 1まで繰り返す
                積和 = 積和 + 行値[J] × 重[J]
            ここまで
            スコアに積和を配列追加
        ここまで
        確率 = スコアのソフトマックス変換
        正解番号 = 正解番号一覧[I]
        対数和 = 対数和 + ((確率[正解番号] + 交差エントロピー微小値)のLOG)
        確率[正解番号] = 確率[正解番号] - 1
        誤差表に確率を配列追加
    ここまで
    {"誤差表": 誤差表, "対数和": 対数和}で戻る
ここまで

# 品種誤差計算 を、品種が 3 つのときに限って、品種ごとの繰り返しを使わずに書いたもの。
# 3 つのスコア・指数・確率をそれぞれ変数に持つ。足す順と比べ方は ソフトマックス変換 と同じ
# （最大値は先頭から「>」で比べて選び、指数の和は 0 に左から足す。0 + 指数 は指数そのもの）。
●(行一覧と正解番号一覧を重み転置と切片で)三品種誤差計算とは
    列数 = 重み転置[0]の要素数
    重零 = 重み転置[0]
    重一 = 重み転置[1]
    重二 = 重み転置[2]
    切片零 = 切片[0]
    切片一 = 切片[1]
    切片二 = 切片[2]
    対数和 = 0
    誤差表 = []
    Iを 0から (行一覧の要素数) - 1まで繰り返す
        行値 = 行一覧[I]
        得点零 = 切片零
        得点一 = 切片一
        得点二 = 切片二
        Jを 0から 列数 - 1まで繰り返す
            特徴値 = 行値[J]
            得点零 = 得点零 + 特徴値 × 重零[J]
            得点一 = 得点一 + 特徴値 × 重一[J]
            得点二 = 得点二 + 特徴値 × 重二[J]
        ここまで
        最大 = 得点零
        もし、得点一 > 最大ならば
            最大 = 得点一
        ここまで
        もし、得点二 > 最大ならば
            最大 = 得点二
        ここまで
        指数零 = (得点零 - 最大)のEXP
        指数一 = (得点一 - 最大)のEXP
        指数二 = (得点二 - 最大)のEXP
        指数和 = 指数零 + 指数一 + 指数二
        確率 = [指数零 ÷ 指数和, 指数一 ÷ 指数和, 指数二 ÷ 指数和]
        正解番号 = 正解番号一覧[I]
        対数和 = 対数和 + ((確率[正解番号] + 交差エントロピー微小値)のLOG)
        確率[正解番号] = 確率[正解番号] - 1
        誤差表に確率を配列追加
    ここまで
    {"誤差表": 誤差表, "対数和": 対数和}で戻る
ここまで

# バッチ勾配降下法で重みと切片を学習する。重みは 重み[特徴量][品種] で返す。
# 返すのは {"列名一覧", "品種一覧", "重み", "切片", "損失一覧"} の辞書。
#
# 1 回の繰り返しで、全行のスコア・確率・損失・勾配を求めてから、重みと切片をまとめて更新する。
# 素朴に書くと 1 回あたり約 8 万命令かかり、5000 回で gonako の命令数の上限（2 億）を超える。
# 足す順と演算の順は変えずに、書き方だけを変えて命令を減らす（計算の結果は変わらない）。
# - 重みは 重み転置[品種][特徴量] で持ち、添字を 1 段にする
# - 品種が 3 つなら、品種ごとの繰り返しを使わない 三品種誤差計算 で行ごとの計算をする
# - 勾配は、誤差表を 表行列交換 で品種ごとの列にし、特徴量ごとに行の順に 0 から足す
# - 切片の勾配は 表列合計 で求める（0 から行の順に足す。表行列交換 と同じく Go で書かれた命令）
●(特徴量一覧と正解一覧を列名一覧と学習率と反復回数で)ロジスティック学習とは
    件数 = 特徴量一覧の要素数
    もし、件数 ≠ (正解一覧の要素数)ならば
        「特徴量と正解ラベルの件数が違います: {件数} と {正解一覧の要素数}」のエラー発生
    ここまで
    もし、件数 = 0ならば
        「特徴量が 1 件もありません」のエラー発生
    ここまで
    行一覧 = []
    Iを 0から 件数 - 1まで繰り返す
        行一覧に(特徴量一覧[I]を列名一覧で行値抽出)を配列追加
    ここまで
    品種一覧 = 正解一覧の品種整列
    正解番号一覧 = []
    Iを 0から 件数 - 1まで繰り返す
        正解番号一覧に(品種一覧から(正解一覧[I])を配列検索)を配列追加
    ここまで
    列数 = 列名一覧の要素数
    品種数 = 品種一覧の要素数
    列値一覧 = 行一覧を表行列交換
    重み転置 = 品種数と列数の零行列作成
    切片 = (1と品種数の零行列作成)[0]
    損失一覧 = []
    (反復回数)回
        もし、品種数 = 3ならば
            計算結果 = 行一覧と正解番号一覧を重み転置と切片で三品種誤差計算
        違えば
            計算結果 = 行一覧と正解番号一覧を重み転置と切片で品種誤差計算
        ここまで
        誤差表 = 計算結果["誤差表"]
        損失一覧に(0 - 計算結果["対数和"] ÷ 件数)を配列追加
        # 勾配（行の順に 0 から足す）で重みと切片を更新する。
        誤差列一覧 = 誤差表を表行列交換
        Jを 0から 列数 - 1まで繰り返す
            列値 = 列値一覧[J]
            もし、品種数 = 3ならば
                # 品種が 3 つなら、3 つの勾配を 1 回の行の繰り返しで同時に足す（それぞれの足す順は同じ）。
                誤差零 = 誤差列一覧[0]
                誤差一 = 誤差列一覧[1]
                誤差二 = 誤差列一覧[2]
                勾配零 = 0
                勾配一 = 0
                勾配二 = 0
                Iを 0から 件数 - 1まで繰り返す
                    特徴値 = 列値[I]
                    勾配零 = 勾配零 + 特徴値 × 誤差零[I]
                    勾配一 = 勾配一 + 特徴値 × 誤差一[I]
                    勾配二 = 勾配二 + 特徴値 × 誤差二[I]
                ここまで
                重み転置[0][J] = 重み転置[0][J] - 学習率 × 勾配零 ÷ 件数
                重み転置[1][J] = 重み転置[1][J] - 学習率 × 勾配一 ÷ 件数
                重み転置[2][J] = 重み転置[2][J] - 学習率 × 勾配二 ÷ 件数
            違えば
                Kを 0から 品種数 - 1まで繰り返す
                    誤差列 = 誤差列一覧[K]
                    勾配 = 0
                    Iを 0から 件数 - 1まで繰り返す
                        勾配 = 勾配 + 列値[I] × 誤差列[I]
                    ここまで
                    重み転置[K][J] = 重み転置[K][J] - 学習率 × 勾配 ÷ 件数
                ここまで
            ここまで
        ここまで
        Kを 0から 品種数 - 1まで繰り返す
            切片[K] = 切片[K] - 学習率 × (誤差表のKを表列合計) ÷ 件数
        ここまで
    ここまで
    重み = 列数と品種数の零行列作成
    Jを 0から 列数 - 1まで繰り返す
        Kを 0から 品種数 - 1まで繰り返す
            重み[J][K] = 重み転置[K][J]
        ここまで
    ここまで
    {"列名一覧": 列名一覧, "品種一覧": 品種一覧, "重み": 重み, "切片": 切片, "損失一覧": 損失一覧}で戻る
ここまで

# 最大値の添字。同じ値なら先に現れたほうを選ぶ（「>」で比べるので後ろの同じ値には入れ替えない）。
●(値一覧の)スコア最大添字とは
    最良 = 0
    Iを 1から (値一覧の要素数) - 1まで繰り返す
        もし、値一覧[I] > 値一覧[最良]ならば
            最良 = I
        ここまで
    ここまで
    最良で戻る
ここまで

# スコアが最大の品種を予測する。確率に直さなくても、最大の品種は変わらない。
●(回帰結果で特徴量一覧を)ロジスティック予測とは
    予測一覧 = []
    Iを 0から (特徴量一覧の要素数) - 1まで繰り返す
        行値 = 特徴量一覧[I]を(回帰結果["列名一覧"])で行値抽出
        スコア = 行値と(回帰結果["重み"])と(回帰結果["切片"])のロジスティック行スコア
        予測一覧に(回帰結果["品種一覧"][スコアのスコア最大添字])を配列追加
    ここまで
    予測一覧で戻る
ここまで

# ---- ランダムフォレスト ----

# サンプルごとに、最も多い予測を選ぶ。同数なら先に現れた予測を選ぶ（第 3 章の 多数決）。
●(投票一覧の)森多数決とは
    結果 = []
    もし、(投票一覧の要素数) = 0ならば
        結果で戻る
    ここまで
    Iを 0から (投票一覧[0]の要素数) - 1まで繰り返す
        票一覧 = []
        Jを 0から (投票一覧の要素数) - 1まで繰り返す
            票一覧に投票一覧[J][I]を配列追加
        ここまで
        結果に(票一覧の多数決)を配列追加
    ここまで
    結果で戻る
ここまで

# 0 から 件数 - 1 までの行番号を、重複を許して 件数 個選ぶ。
# 生成器（第 2 章の 乱数生成器作成 で作った辞書）は参照で渡り、状態が進む。
# 森を作るときは、1 本目の続きから 2 本目の乱数を引く。
●(生成器と件数の)ブートストラップ標本作成とは
    結果 = []
    (件数)回
        結果に(生成器と件数の次整数)を配列追加
    ここまで
    結果で戻る
ここまで

# 渡された生成器の続きで Fisher-Yates の並べ替えをした新しい配列を返す。
# 第 2 章の 並べ替え と同じ手順だが、シードではなく生成器を受け取る。
●(配列を生成器で)生成器並べ替えとは
    結果 = 配列を配列複製
    位置 = (結果の要素数) - 1
    (位置 ≧ 1)の間
        J = 生成器と(位置 + 1)の次整数
        退避 = 結果[位置]
        結果[位置] = 結果[J]
        結果[J] = 退避
        位置 = 位置 - 1
    ここまで
    結果で戻る
ここまで

# ブートストラップ標本と特徴量の部分集合で、第 3 章の決定木を 森設定["木数"] 本学習する。
# 森設定は {"木数", "特徴量数", "深さ上限", "シード"} の辞書。
# 第 3 章の 決定木学習 は列名一覧で見る列を決めるので、特徴量の辞書から列を削らずに、
# 選んだ列名だけを渡せば部分集合になる（第 3 章は書き換えない）。
●(特徴量一覧と正解一覧を列名一覧と森設定で)ランダムフォレスト学習とは
    件数 = 特徴量一覧の要素数
    もし、件数 ≠ (正解一覧の要素数)ならば
        「特徴量と正解ラベルの件数が違います: {件数} と {正解一覧の要素数}」のエラー発生
    ここまで
    もし、件数 = 0ならば
        「特徴量が 1 件もありません」のエラー発生
    ここまで
    生成器 = (森設定["シード"])の乱数生成器作成
    選択数 = (森設定["特徴量数"])と(列名一覧の要素数)の最小値
    木一覧 = []
    (森設定["木数"])回
        行番号一覧 = 生成器と件数のブートストラップ標本作成
        並び = 列名一覧を生成器で生成器並べ替え
        選択 = 並びの0から選択数まで部分配列取得
        # 列の順は元のまま残す。第 3 章は同じ不純度なら列の順で前の分割を選ぶので、
        # 並べ替えた順で渡すと同点の倒し方が変わり、ほかの言語版と木が違ってしまう。
        木列 = []
        Jを 0から (列名一覧の要素数) - 1まで繰り返す
            もし、(選択から(列名一覧[J])を配列検索) ≧ 0ならば
                木列に列名一覧[J]を配列追加
            ここまで
        ここまで
        標本特徴量 = []
        標本正解 = []
        Jを 0から 件数 - 1まで繰り返す
            標本特徴量に特徴量一覧[行番号一覧[J]]を配列追加
            標本正解に正解一覧[行番号一覧[J]]を配列追加
        ここまで
        木 = 標本特徴量と標本正解を木列と(森設定["深さ上限"])で決定木学習
        木一覧に{"列名一覧": 木列, "行番号一覧": 行番号一覧, "木": 木}を配列追加
    ここまで
    {"木一覧": 木一覧}で戻る
ここまで

# 木ごとの予測を多数決でまとめる。
●(森で特徴量一覧を)ランダムフォレスト予測とは
    投票一覧 = []
    木一覧 = 森["木一覧"]
    Iを 0から (木一覧の要素数) - 1まで繰り返す
        投票一覧に((木一覧[I]["木"])で特徴量一覧を決定木予測)を配列追加
    ここまで
    投票一覧の森多数決で戻る
ここまで

# ---- 特徴量の重要度 ----

# 分割ごとに減った不純度（件数で重み付け）を、[列名, 減った量] の配列にする。
# 節を先に、次に左、最後に右の順に並べる。
●(木と特徴量一覧と正解一覧の)不純度減少列挙とは
    結果 = []
    もし、木["種別"] = 「葉」ならば
        結果で戻る
    ここまで
    分割 = 木["分割"]
    左特徴量 = []
    左正解 = []
    右特徴量 = []
    右正解 = []
    Iを 0から (特徴量一覧の要素数) - 1まで繰り返す
        もし、(特徴量一覧[I]の(分割["特徴量"])を特徴量値取得) ≦ 分割["境界"]ならば
            左特徴量に特徴量一覧[I]を配列追加
            左正解に正解一覧[I]を配列追加
        違えば
            右特徴量に特徴量一覧[I]を配列追加
            右正解に正解一覧[I]を配列追加
        ここまで
    ここまで
    減少量 = (正解一覧の要素数) × ((正解一覧のジニ不純度) - 分割["不純度"])
    結果に[分割["特徴量"], 減少量]を配列追加
    左結果 = (木["左"])と左特徴量と左正解の不純度減少列挙
    右結果 = (木["右"])と右特徴量と右正解の不純度減少列挙
    Iを 0から (左結果の要素数) - 1まで繰り返す
        結果に左結果[I]を配列追加
    ここまで
    Iを 0から (右結果の要素数) - 1まで繰り返す
        結果に右結果[I]を配列追加
    ここまで
    結果で戻る
ここまで

# 合計が 1 になるように割った新しい辞書を返す。合計が 0 ならそのままの値で返す。
# 合計はキーを入れた順（列の順）に足す。
●(合計一覧の)重要度正規化とは
    キー一覧 = 合計一覧のハッシュキー列挙
    総量 = 0
    Iを 0から (キー一覧の要素数) - 1まで繰り返す
        総量 = 総量 + 合計一覧[キー一覧[I]]
    ここまで
    結果 = {}
    Iを 0から (キー一覧の要素数) - 1まで繰り返す
        キー = キー一覧[I]
        もし、総量 = 0ならば
            結果[キー] = 合計一覧[キー]
        違えば
            結果[キー] = 合計一覧[キー] ÷ 総量
        ここまで
    ここまで
    結果で戻る
ここまで

# 決定木 1 本の重要度。列名から重要度への辞書（列の順）で、合計が 1 になる。
●(木と特徴量一覧と正解一覧を列名一覧で)決定木重要度とは
    合計一覧 = {}
    Iを 0から (列名一覧の要素数) - 1まで繰り返す
        合計一覧[列名一覧[I]] = 0
    ここまで
    減少一覧 = 木と特徴量一覧と正解一覧の不純度減少列挙
    Iを 0から (減少一覧の要素数) - 1まで繰り返す
        列名 = 減少一覧[I][0]
        合計一覧[列名] = 合計一覧[列名] + 減少一覧[I][1]
    ここまで
    合計一覧の重要度正規化で戻る
ここまで

# 木ごとの重要度の平均。木ごとに、その木のブートストラップ標本の上で測り直す。
# 木が使わなかった特徴量は、その木では 0 とする。
●(森と特徴量一覧と正解一覧を列名一覧で)森重要度とは
    合計一覧 = {}
    Iを 0から (列名一覧の要素数) - 1まで繰り返す
        合計一覧[列名一覧[I]] = 0
    ここまで
    木一覧 = 森["木一覧"]
    本数 = 木一覧の要素数
    Iを 0から 本数 - 1まで繰り返す
        森木 = 木一覧[I]
        行番号一覧 = 森木["行番号一覧"]
        標本特徴量 = []
        標本正解 = []
        Jを 0から (行番号一覧の要素数) - 1まで繰り返す
            標本特徴量に特徴量一覧[行番号一覧[J]]を配列追加
            標本正解に正解一覧[行番号一覧[J]]を配列追加
        ここまで
        木列 = 森木["列名一覧"]
        木重要度 = (森木["木"])と標本特徴量と標本正解を木列で決定木重要度
        Jを 0から (木列の要素数) - 1まで繰り返す
            列名 = 木列[J]
            合計一覧[列名] = 合計一覧[列名] + 木重要度[列名] ÷ 本数
        ここまで
    ここまで
    合計一覧の重要度正規化で戻る
ここまで

# ---- モデル共通の約束 ----

# 深さの呼び名。NULL は上限なし。
●(深さ上限の)深さ呼称とは
    もし、深さ上限 === NULLならば
