# 第 10 章: ロジスティック回帰とアンサンブル学習。
#
# なでしこ3 には機械学習のライブラリが無いので、ロジスティック回帰もランダムフォレストも
# ここで作るものがそのまま最終実装になる。突き合わせる相手はほかの言語版の数値である。
#
# モデル共通の約束: なでしこ3 には型もインターフェースも無いので、モデルを
# {"名前": 表に載せる名前, "学習": 関数(特徴量一覧, 正解一覧, 列名一覧)} の辞書で表す。
# 「学習」は、学習を済ませて「予測する関数」（関数(特徴量一覧)）を返す。
# 約束を守っているかは誰も検査しないので、守りはテストだけである。

!「./chapter03.nako3」を取り込む

# 確率が 0 のときに LOG が負の無限大にならないように足す値。
交差エントロピー微小値 = 0.000000000001
# 森に作る木の数。
森木数既定 = 100
# 1 本の木に渡す特徴量の数。
森特徴量数既定 = 2
# 比べる決定木の深さ。
比較木深さ = 2
# 分割と森のシード。
比較乱数シード = 0

# ---- ソフトマックス関数と交差エントロピー ----

# スコアを、合計が 1 になる確率に変換する。
# 最大値を引いてから EXP を求めるので、大きな値でもあふれない（引いた分は分母と分子で打ち消し合う）。
# なでしこ3 の EXP は止まらずに Infinity を返すので、引き算を省くと Infinity ÷ Infinity で NaN になる。
●(スコア一覧の)ソフトマックス変換とは
    結果 = []
    件数 = スコア一覧の要素数
    もし、件数 = 0ならば
        結果で戻る
    ここまで
    最大 = スコア一覧[0]
    Iを 0から 件数 - 1まで繰り返す
        もし、スコア一覧[I] > 最大ならば
            最大 = スコア一覧[I]
        ここまで
    ここまで
    指数一覧 = []
    指数和 = 0
    Iを 0から 件数 - 1まで繰り返す
        指数 = (スコア一覧[I] - 最大)のEXP
        指数一覧に指数を配列追加
        指数和 = 指数和 + 指数
    ここまで
    Iを 0から 件数 - 1まで繰り返す
        結果に(指数一覧[I] ÷ 指数和)を配列追加
    ここまで
    結果で戻る
ここまで

# 交差エントロピー。正解の品種の確率の対数の平均に、マイナスを付けたもの。
# LOG は 0 で止まらずに -Infinity を返すので、ごく小さい値を足してから対数を取る。
●(確率一覧と正解番号一覧の)交差エントロピーとは
    件数 = 確率一覧の要素数
    もし、件数 = 0ならば
        0で戻る
    ここまで
    対数和 = 0
    Iを 0から 件数 - 1まで繰り返す
        確率 = 確率一覧[I][正解番号一覧[I]]
        対数和 = 対数和 + ((確率 + 交差エントロピー微小値)のLOG)
    ここまで
    0 - 対数和 ÷ 件数で戻る
ここまで

# ---- ロジスティック回帰 ----

# 正解ラベルから品種を重複なく取り出し、名前の順に並べた新しい配列を返す。
●(正解一覧の)品種整列とは
    既出 = {}
    品種一覧 = []
    Iを 0から (正解一覧の要素数) - 1まで繰り返す
        品種 = 正解一覧[I]
        もし、(既出の品種がハッシュキー存在) = 偽ならば
            既出[品種] = 真
            品種一覧に品種を配列追加
        ここまで
    ここまで
    品種一覧を配列ソート
    品種一覧で戻る
ここまで

# 行数 × 列数の、すべて 0 の表を返す。
●(行数と列数の)零行列作成とは
    結果 = []
    (行数)回
        行 = []
        (列数)回
            行に0を配列追加
        ここまで
        結果に行を配列追加
    ここまで
    結果で戻る
ここまで

# 1 行のスコア（品種ごと）。切片から始めて、特徴量を外、品種を内にして足し込む。
# 足し込む順をほかの言語版にそろえる（浮動小数点の足し算は順で最後の桁が変わる）。
●(行値一覧と重み一覧と切片一覧の)ロジスティック行スコアとは
    スコア = 切片一覧を配列複製
    Jを 0から (行値一覧の要素数) - 1まで繰り返す
        Kを 0から (スコアの要素数) - 1まで繰り返す
            スコア[K] = スコア[K] + 行値一覧[J] × 重み一覧[J][K]
        ここまで
    ここまで
    スコアで戻る
ここまで

# 特徴量の辞書から、列名一覧の順に値を読んだ配列を返す。列が無ければエラーを起こす。
●(特徴量を列名一覧で)行値抽出とは
    結果 = []
    Jを 0から (列名一覧の要素数) - 1まで繰り返す
        結果に(特徴量の(列名一覧[J])を特徴量値取得)を配列追加
    ここまで
    結果で戻る
ここまで

# バッチ勾配降下法で重みと切片を学習する。重みは 重み[特徴量][品種] で持つ。
# 返すのは {"列名一覧", "品種一覧", "重み", "切片", "損失一覧"} の辞書。
●(特徴量一覧と正解一覧を列名一覧と学習率と反復回数で)ロジスティック学習とは
    件数 = 特徴量一覧の要素数
    もし、件数 ≠ (正解一覧の要素数)ならば
        「特徴量と正解ラベルの件数が違います: {件数} と {正解一覧の要素数}」のエラー発生
    ここまで
    もし、件数 = 0ならば
        「特徴量が 1 件もありません」のエラー発生
    ここまで
    行一覧 = []
    Iを 0から 件数 - 1まで繰り返す
        行一覧に(特徴量一覧[I]を列名一覧で行値抽出)を配列追加
    ここまで
    品種一覧 = 正解一覧の品種整列
    正解番号一覧 = []
    Iを 0から 件数 - 1まで繰り返す
        正解番号一覧に(品種一覧から(正解一覧[I])を配列検索)を配列追加
    ここまで
    列数 = 列名一覧の要素数
    品種数 = 品種一覧の要素数
    重み = 列数と品種数の零行列作成
    切片 = (1と品種数の零行列作成)[0]
    損失一覧 = []
    (反復回数)回
        確率一覧 = []
        Iを 0から 件数 - 1まで繰り返す
            確率一覧に((行一覧[I])と重みと切片のロジスティック行スコア)のソフトマックス変換を配列追加
        ここまで
        損失一覧に(確率一覧と正解番号一覧の交差エントロピー)を配列追加
        重み勾配 = 列数と品種数の零行列作成
        切片勾配 = (1と品種数の零行列作成)[0]
        Iを 0から 件数 - 1まで繰り返す
            # 誤差は「確率 − 正解」。正解の品種だけ 1 を引く。
            誤差 = 確率一覧[I]を配列複製
            正解番号 = 正解番号一覧[I]
            誤差[正解番号] = 誤差[正解番号] - 1
            行値 = 行一覧[I]
            Jを 0から 列数 - 1まで繰り返す
                Kを 0から 品種数 - 1まで繰り返す
                    重み勾配[J][K] = 重み勾配[J][K] + 行値[J] × 誤差[K]
                ここまで
            ここまで
            Kを 0から 品種数 - 1まで繰り返す
                切片勾配[K] = 切片勾配[K] + 誤差[K]
            ここまで
        ここまで
        Jを 0から 列数 - 1まで繰り返す
            Kを 0から 品種数 - 1まで繰り返す
                重み[J][K] = 重み[J][K] - 学習率 × 重み勾配[J][K] ÷ 件数
            ここまで
        ここまで
        Kを 0から 品種数 - 1まで繰り返す
            切片[K] = 切片[K] - 学習率 × 切片勾配[K] ÷ 件数
        ここまで
    ここまで
    {"列名一覧": 列名一覧, "品種一覧": 品種一覧, "重み": 重み, "切片": 切片, "損失一覧": 損失一覧}で戻る
ここまで

# 最大値の添字。同じ値なら先に現れたほうを選ぶ（「>」で比べるので後ろの同じ値には入れ替えない）。
●(値一覧の)スコア最大添字とは
    最良 = 0
    Iを 1から (値一覧の要素数) - 1まで繰り返す
        もし、値一覧[I] > 値一覧[最良]ならば
            最良 = I
        ここまで
    ここまで
    最良で戻る
ここまで

# スコアが最大の品種を予測する。確率に直さなくても、最大の品種は変わらない。
●(回帰結果で特徴量一覧を)ロジスティック予測とは
    予測一覧 = []
    Iを 0から (特徴量一覧の要素数) - 1まで繰り返す
        行値 = 特徴量一覧[I]を(回帰結果["列名一覧"])で行値抽出
        スコア = 行値と(回帰結果["重み"])と(回帰結果["切片"])のロジスティック行スコア
        予測一覧に(回帰結果["品種一覧"][スコアのスコア最大添字])を配列追加
    ここまで
    予測一覧で戻る
ここまで

# ---- ランダムフォレスト ----

# サンプルごとに、最も多い予測を選ぶ。同数なら先に現れた予測を選ぶ（第 3 章の 多数決）。
●(投票一覧の)森多数決とは
    結果 = []
    もし、(投票一覧の要素数) = 0ならば
        結果で戻る
    ここまで
    Iを 0から (投票一覧[0]の要素数) - 1まで繰り返す
        票一覧 = []
        Jを 0から (投票一覧の要素数) - 1まで繰り返す
            票一覧に投票一覧[J][I]を配列追加
        ここまで
        結果に(票一覧の多数決)を配列追加
    ここまで
    結果で戻る
ここまで

# 0 から 件数 - 1 までの行番号を、重複を許して 件数 個選ぶ。
# 生成器（第 2 章の 乱数生成器作成 で作った辞書）は参照で渡り、状態が進む。
# 森を作るときは、1 本目の続きから 2 本目の乱数を引く。
●(生成器と件数の)ブートストラップ標本作成とは
    結果 = []
    (件数)回
        結果に(生成器と件数の次整数)を配列追加
    ここまで
    結果で戻る
ここまで

# 渡された生成器の続きで Fisher-Yates の並べ替えをした新しい配列を返す。
# 第 2 章の 並べ替え と同じ手順だが、シードではなく生成器を受け取る。
●(配列を生成器で)生成器並べ替えとは
    結果 = 配列を配列複製
    位置 = (結果の要素数) - 1
    (位置 ≧ 1)の間
        J = 生成器と(位置 + 1)の次整数
        退避 = 結果[位置]
        結果[位置] = 結果[J]
        結果[J] = 退避
        位置 = 位置 - 1
    ここまで
    結果で戻る
ここまで

# ブートストラップ標本と特徴量の部分集合で、第 3 章の決定木を 森設定["木数"] 本学習する。
# 森設定は {"木数", "特徴量数", "深さ上限", "シード"} の辞書。
# 第 3 章の 決定木学習 は列名一覧で見る列を決めるので、特徴量の辞書から列を削らずに、
# 選んだ列名だけを渡せば部分集合になる（第 3 章は書き換えない）。
●(特徴量一覧と正解一覧を列名一覧と森設定で)ランダムフォレスト学習とは
    件数 = 特徴量一覧の要素数
    もし、件数 ≠ (正解一覧の要素数)ならば
        「特徴量と正解ラベルの件数が違います: {件数} と {正解一覧の要素数}」のエラー発生
    ここまで
    もし、件数 = 0ならば
        「特徴量が 1 件もありません」のエラー発生
    ここまで
    生成器 = (森設定["シード"])の乱数生成器作成
    選択数 = (森設定["特徴量数"])と(列名一覧の要素数)の最小値
    木一覧 = []
    (森設定["木数"])回
        行番号一覧 = 生成器と件数のブートストラップ標本作成
        並び = 列名一覧を生成器で生成器並べ替え
        選択 = 並びの0から選択数まで部分配列取得
        # 列の順は元のまま残す。第 3 章は同じ不純度なら列の順で前の分割を選ぶので、
        # 並べ替えた順で渡すと同点の倒し方が変わり、ほかの言語版と木が違ってしまう。
        木列 = []
        Jを 0から (列名一覧の要素数) - 1まで繰り返す
            もし、(選択から(列名一覧[J])を配列検索) ≧ 0ならば
                木列に列名一覧[J]を配列追加
            ここまで
        ここまで
        標本特徴量 = []
        標本正解 = []
        Jを 0から 件数 - 1まで繰り返す
            標本特徴量に特徴量一覧[行番号一覧[J]]を配列追加
            標本正解に正解一覧[行番号一覧[J]]を配列追加
        ここまで
        木 = 標本特徴量と標本正解を木列と(森設定["深さ上限"])で決定木学習
        木一覧に{"列名一覧": 木列, "行番号一覧": 行番号一覧, "木": 木}を配列追加
    ここまで
    {"木一覧": 木一覧}で戻る
ここまで

# 木ごとの予測を多数決でまとめる。
●(森で特徴量一覧を)ランダムフォレスト予測とは
    投票一覧 = []
    木一覧 = 森["木一覧"]
    Iを 0から (木一覧の要素数) - 1まで繰り返す
        投票一覧に((木一覧[I]["木"])で特徴量一覧を決定木予測)を配列追加
    ここまで
    投票一覧の森多数決で戻る
ここまで

# ---- 特徴量の重要度 ----

# 分割ごとに減った不純度（件数で重み付け）を、[列名, 減った量] の配列にする。
# 節を先に、次に左、最後に右の順に並べる。
●(木と特徴量一覧と正解一覧の)不純度減少列挙とは
    結果 = []
    もし、木["種別"] = 「葉」ならば
        結果で戻る
    ここまで
    分割 = 木["分割"]
    左特徴量 = []
    左正解 = []
    右特徴量 = []
    右正解 = []
    Iを 0から (特徴量一覧の要素数) - 1まで繰り返す
        もし、(特徴量一覧[I]の(分割["特徴量"])を特徴量値取得) ≦ 分割["境界"]ならば
            左特徴量に特徴量一覧[I]を配列追加
            左正解に正解一覧[I]を配列追加
        違えば
            右特徴量に特徴量一覧[I]を配列追加
            右正解に正解一覧[I]を配列追加
        ここまで
    ここまで
    減少量 = (正解一覧の要素数) × ((正解一覧のジニ不純度) - 分割["不純度"])
    結果に[分割["特徴量"], 減少量]を配列追加
    左結果 = (木["左"])と左特徴量と左正解の不純度減少列挙
    右結果 = (木["右"])と右特徴量と右正解の不純度減少列挙
    Iを 0から (左結果の要素数) - 1まで繰り返す
        結果に左結果[I]を配列追加
    ここまで
    Iを 0から (右結果の要素数) - 1まで繰り返す
        結果に右結果[I]を配列追加
    ここまで
    結果で戻る
ここまで

# 合計が 1 になるように割った新しい辞書を返す。合計が 0 ならそのままの値で返す。
# 合計はキーを入れた順（列の順）に足す。
●(合計一覧の)重要度正規化とは
    キー一覧 = 合計一覧のハッシュキー列挙
    総量 = 0
    Iを 0から (キー一覧の要素数) - 1まで繰り返す
        総量 = 総量 + 合計一覧[キー一覧[I]]
    ここまで
    結果 = {}
    Iを 0から (キー一覧の要素数) - 1まで繰り返す
        キー = キー一覧[I]
        もし、総量 = 0ならば
            結果[キー] = 合計一覧[キー]
        違えば
            結果[キー] = 合計一覧[キー] ÷ 総量
        ここまで
    ここまで
    結果で戻る
ここまで

# 決定木 1 本の重要度。列名から重要度への辞書（列の順）で、合計が 1 になる。
●(木と特徴量一覧と正解一覧を列名一覧で)決定木重要度とは
    合計一覧 = {}
    Iを 0から (列名一覧の要素数) - 1まで繰り返す
        合計一覧[列名一覧[I]] = 0
    ここまで
    減少一覧 = 木と特徴量一覧と正解一覧の不純度減少列挙
    Iを 0から (減少一覧の要素数) - 1まで繰り返す
        列名 = 減少一覧[I][0]
        合計一覧[列名] = 合計一覧[列名] + 減少一覧[I][1]
    ここまで
    合計一覧の重要度正規化で戻る
ここまで

# 木ごとの重要度の平均。木ごとに、その木のブートストラップ標本の上で測り直す。
# 木が使わなかった特徴量は、その木では 0 とする。
●(森と特徴量一覧と正解一覧を列名一覧で)森重要度とは
    合計一覧 = {}
    Iを 0から (列名一覧の要素数) - 1まで繰り返す
        合計一覧[列名一覧[I]] = 0
    ここまで
    木一覧 = 森["木一覧"]
    本数 = 木一覧の要素数
    Iを 0から 本数 - 1まで繰り返す
        森木 = 木一覧[I]
        行番号一覧 = 森木["行番号一覧"]
        標本特徴量 = []
        標本正解 = []
        Jを 0から (行番号一覧の要素数) - 1まで繰り返す
            標本特徴量に特徴量一覧[行番号一覧[J]]を配列追加
            標本正解に正解一覧[行番号一覧[J]]を配列追加
        ここまで
        木列 = 森木["列名一覧"]
        木重要度 = (森木["木"])と標本特徴量と標本正解を木列で決定木重要度
        Jを 0から (木列の要素数) - 1まで繰り返す
            列名 = 木列[J]
            合計一覧[列名] = 合計一覧[列名] + 木重要度[列名] ÷ 本数
        ここまで
    ここまで
    合計一覧の重要度正規化で戻る
ここまで

# ---- モデル共通の約束 ----

# 深さの呼び名。NULL は上限なし。
●(深さ上限の)深さ呼称とは
    もし、深さ上限 === NULLならば
        「深さの上限なし」で戻る
    ここまで
    「深さ {深さ上限}」で戻る
ここまで

# 第 3 章の決定木を、約束の形（名前と学習の辞書）にする。
# 「学習」の中の無名関数は、作ったときの 深さ上限 を覚えている。
●(深さ上限の)決定木モデル作成とは
    学習 = 関数(特徴量一覧, 正解一覧, 列名一覧)
        学習木 = 特徴量一覧と正解一覧を列名一覧と深さ上限で決定木学習
        予測 = 関数(対象一覧)
            学習木で対象一覧を決定木予測で戻る
        ここまで
        予測で戻る
    ここまで
    {"名前": 「決定木（{深さ上限の深さ呼称}）」, "学習": 学習}で戻る
ここまで

# ロジスティック回帰を、約束の形にする。
●(学習率と反復回数の)ロジスティックモデル作成とは
    学習 = 関数(特徴量一覧, 正解一覧, 列名一覧)
        回帰結果 = 特徴量一覧と正解一覧を列名一覧と学習率と反復回数でロジスティック学習
        予測 = 関数(対象一覧)
            回帰結果で対象一覧をロジスティック予測で戻る
        ここまで
        予測で戻る
    ここまで
    {"名前": 「ロジスティック回帰」, "学習": 学習}で戻る
ここまで

# ランダムフォレストを、約束の形にする。
●(森設定の)森モデル作成とは
    後置 = 「」
    もし、森設定["深さ上限"] !== NULLならば
        後置 = 「・{(森設定["深さ上限"])の深さ呼称}」
    ここまで
    学習 = 関数(特徴量一覧, 正解一覧, 列名一覧)
        森 = 特徴量一覧と正解一覧を列名一覧と森設定でランダムフォレスト学習
        予測 = 関数(対象一覧)
            森で対象一覧をランダムフォレスト予測で戻る
        ここまで
        予測で戻る
    ここまで
    {"名前": 「ランダムフォレスト（{森設定["木数"]} 本{後置}）」, "学習": 学習}で戻る
ここまで

# モデルを訓練データで学習させてから、訓練データとテストデータの正解率を [訓練, テスト] で返す。
# 辞書から取り出した関数は、いったん変数に入れてから呼ぶ（辞書["学習"](…) とは書けない）。
●(モデルと分割結果と列名一覧の)モデル評価とは
    学習関数 = モデル["学習"]
    訓練特徴量 = 分割結果["訓練特徴量"]
    テスト特徴量 = 分割結果["テスト特徴量"]
    予測関数 = 学習関数(訓練特徴量, 分割結果["訓練正解"], 列名一覧)
    訓練予測 = 予測関数(訓練特徴量)
    テスト予測 = 予測関数(テスト特徴量)
    [(訓練予測と(分割結果["訓練正解"])の正解率), (テスト予測と(分割結果["テスト正解"])の正解率)]で戻る
ここまで

# 表示する順に並べたモデル。
●比較モデル一覧作成とは
    [(比較木深さの決定木モデル作成), (1と5000のロジスティックモデル作成), ({"木数": 森木数既定, "特徴量数": 森特徴量数既定, "深さ上限": NULL, "シード": 比較乱数シード}の森モデル作成), ({"木数": 森木数既定, "特徴量数": 森特徴量数既定, "深さ上限": 比較木深さ, "シード": 比較乱数シード}の森モデル作成)]で戻る
ここまで

# ---- 実データでの実行 ----

# 読み込んだ中身から、モデルごとの正解率と森の特徴量の重要度の報告を作る。テストで確かめられる。
●(CSV文字列を)モデル比較報告作成とは
    分割結果 = CSV文字列を0.3と比較乱数シードでアヤメ前処理
    報告 = 「モデル{タブ}訓練データ{タブ}テストデータ{改行}」
    モデル一覧 = 比較モデル一覧作成
    Iを 0から (モデル一覧の要素数) - 1まで繰り返す
        モデル = モデル一覧[I]
        正解率組 = モデルと分割結果とアヤメ特徴量列のモデル評価
        訓練表示 = (正解率組[0])を4で小数表示
        テスト表示 = (正解率組[1])を4で小数表示
        報告 = 報告 & 「{モデル["名前"]}{タブ}{訓練表示}{タブ}{テスト表示}{改行}」
    ここまで
    森設定 = {"木数": 森木数既定, "特徴量数": 森特徴量数既定, "深さ上限": NULL, "シード": 比較乱数シード}
    訓練特徴量 = 分割結果["訓練特徴量"]
    訓練正解 = 分割結果["訓練正解"]
    森 = 訓練特徴量と訓練正解をアヤメ特徴量列と森設定でランダムフォレスト学習
    重要度 = 森と訓練特徴量と訓練正解をアヤメ特徴量列で森重要度
    報告 = 報告 & 「{改行}ランダムフォレスト（{森木数既定} 本）の特徴量の重要度:{改行}」
    Iを 0から (アヤメ特徴量列の要素数) - 1まで繰り返す
        列名 = アヤメ特徴量列[I]
        重要度表示 = (重要度[列名])を4で小数表示
        報告 = 報告 & 「{列名}{タブ}{重要度表示}{改行}」
    ここまで
    報告で戻る
ここまで

