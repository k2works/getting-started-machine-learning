# 第 7 章: 線形回帰による数値予測。
#
# 正規方程式 (Xᵀ X) w = Xᵀ t を組み立て、連立一次方程式として解いて切片と係数を求める。
# なでしこ3 には行列の命令も機械学習のライブラリも無いので、行列の転置・積・連立一次方程式は
# linear_algebra.nako3 に自作し、ここで作るモデルがそのまま最終実装になる。
#
# モデルは辞書で表す。{"切片": 数, "列名一覧": [列名…], "係数一覧": [数…]}。
# 係数を列名の辞書にせず 2 つの配列で持つのは、ほかの言語版と同じく表示の順を列の順にそろえるため
# （なでしこ3 の辞書はキーを入れた順を保つが、順を保つことを約束として見せたい）。

!「./chapter02.nako3」を取り込む
!「./linear_algebra.nako3」を取り込む
!「./number_format.nako3」を取り込む

# 映画のデータの特徴量の列。cinema_id は映画を区別する番号なので使わない。
映画特徴量列 = [「SNS1」, 「SNS2」, 「actor」, 「original」]

# 映画のデータの正解ラベル（予測したい数値）の列。
映画目的列 = 「sales」

# 外れ値とみなす SNS2 の下限と、興行収入の上限。
映画外れ値反響下限 = 1000
映画外れ値収入上限 = 8500

# 残差。実測値から予測値を引いた値の配列を返す。
●(実測一覧と予測一覧の)回帰残差算出とは
    もし、(実測一覧の要素数) ≠ (予測一覧の要素数)ならば
        「実測値と予測値の件数が違います: {実測一覧の要素数} と {予測一覧の要素数}」のエラー発生
    ここまで
    もし、(実測一覧の要素数) = 0ならば
        「実測値がありません」のエラー発生
    ここまで
    結果 = []
    Iを 0から (実測一覧の要素数) - 1まで繰り返す
        結果に(実測一覧[I] - 予測一覧[I])を配列追加
    ここまで
    結果で戻る
ここまで

# 値の二乗の合計。
●(値一覧の)二乗和算出とは
    総和 = 0
    Iを 0から (値一覧の要素数) - 1まで繰り返す
        総和 = 総和 + 値一覧[I] × 値一覧[I]
    ここまで
    総和で戻る
ここまで

# 平均絶対誤差（MAE）。誤差の絶対値の平均。
●(実測一覧と予測一覧の)平均絶対誤差算出とは
    残差一覧 = 実測一覧と予測一覧の回帰残差算出
    総和 = 0
    Iを 0から (残差一覧の要素数) - 1まで繰り返す
        # 「総和 + (X)の絶対値」と書くと「(総和 + X)の絶対値」と読まれるので、かっこで囲む。
        総和 = 総和 + ((残差一覧[I])の絶対値)
    ここまで
    総和 ÷ (残差一覧の要素数)で戻る
ここまで

# 平均二乗誤差の平方根（RMSE）。
●(実測一覧と予測一覧の)二乗平均平方根誤差算出とは
    残差一覧 = 実測一覧と予測一覧の回帰残差算出
    ((残差一覧の二乗和算出) ÷ (残差一覧の要素数))の平方根で戻る
ここまで

# 決定係数（R²）。1 から「残差の二乗の合計 ÷ 平均との差の二乗の合計」を引いた値。
# 実測値がすべて同じだと割る数が 0 になる。なでしこ3 は 0 で割っても止まらず NaN や
# Infinity を返すので、割る前に確かめてエラーにする。
●(実測一覧と予測一覧の)決定係数算出とは
    残差一覧 = 実測一覧と予測一覧の回帰残差算出
    総和 = 0
    Iを 0から (実測一覧の要素数) - 1まで繰り返す
        総和 = 総和 + 実測一覧[I]
    ここまで
    平均値 = 総和 ÷ (実測一覧の要素数)
    偏差平方和 = 0
    Iを 0から (実測一覧の要素数) - 1まで繰り返す
        偏差 = 実測一覧[I] - 平均値
        偏差平方和 = 偏差平方和 + 偏差 × 偏差
    ここまで
    もし、偏差平方和 = 0ならば
        「実測値がすべて同じ値なので決定係数を求められません」のエラー発生
    ここまで
    1 - (残差一覧の二乗和算出) ÷ 偏差平方和で戻る
ここまで

# 切片・列名・同じ順に並んだ係数からモデルを作る。数が違えばエラーを起こす。
# 配列は参照で渡るので、呼び出し元の配列を持たないよう複製する。
●(切片と列名一覧を係数一覧で)線形回帰モデル作成とは
    もし、(列名一覧の要素数) ≠ (係数一覧の要素数)ならば
        「列名と係数の数が違います: {列名一覧の要素数} と {係数一覧の要素数}」のエラー発生
    ここまで
    列名複製 = []
    係数複製 = []
    Iを 0から (列名一覧の要素数) - 1まで繰り返す
        列名複製に(列名一覧[I])を配列追加
        係数複製に(係数一覧[I])を配列追加
    ここまで
    {"切片": 切片, "列名一覧": 列名複製, "係数一覧": 係数複製}で戻る
ここまで

# 列名で係数を読む。無ければエラーを起こす。
●(モデルの列名を)回帰係数取得とは
    列名一覧 = モデル["列名一覧"]
    Iを 0から (列名一覧の要素数) - 1まで繰り返す
        もし、列名一覧[I] = 列名ならば
            モデル["係数一覧"][I]で戻る
        ここまで
    ここまで
    「係数がありません: {列名}」のエラー発生
ここまで

# 特徴量（列名から数値への辞書）を列名で読む。無ければエラーを起こす。
●(特徴量の列名を)回帰特徴量取得とは
    もし、(特徴量の列名がハッシュキー存在) = 偽ならば
        「特徴量がありません: {列名}」のエラー発生
    ここまで
    特徴量[列名]で戻る
ここまで

# 1 件分の予測値。切片に「係数 × 特徴量」を列の順に足す。係数と特徴量は列名で対応させる。
●(モデルで特徴量を)線形回帰一件予測とは
    予測値 = モデル["切片"]
    列名一覧 = モデル["列名一覧"]
    Iを 0から (列名一覧の要素数) - 1まで繰り返す
        予測値 = 予測値 + モデル["係数一覧"][I] × (特徴量の(列名一覧[I])を回帰特徴量取得)
    ここまで
    予測値で戻る
ここまで

# 行ごとの予測値。
●(モデルで特徴量一覧を)線形回帰予測とは
    結果 = []
    Iを 0から (特徴量一覧の要素数) - 1まで繰り返す
        結果に(モデルで特徴量一覧[I]を線形回帰一件予測)を配列追加
    ここまで
    結果で戻る
ここまで

# 係数を「列名=値」（小数第 4 位まで）の形で並べる。
●(モデルの)回帰係数表示とは
    部分一覧 = []
    列名一覧 = モデル["列名一覧"]
    Iを 0から (列名一覧の要素数) - 1まで繰り返す
        部分一覧に「{列名一覧[I]}={(モデル["係数一覧"][I])を4で小数表示}」を配列追加
    ここまで
    部分一覧を「, 」で配列結合して戻る
ここまで

# 先頭に 1 の列を足した特徴量の行列（計画行列）。1 の列の係数が切片になる。
●(特徴量一覧と列名一覧の)計画行列作成とは
    結果 = []
    Iを 0から (特徴量一覧の要素数) - 1まで繰り返す
        行 = [1]
        Jを 0から (列名一覧の要素数) - 1まで繰り返す
            行に(特徴量一覧[I]の(列名一覧[J])を回帰特徴量取得)を配列追加
        ここまで
        結果に行を配列追加
    ここまで
    結果で戻る
ここまで

# 正規方程式 (Xᵀ X) w = Xᵀ t を解いて、切片と係数を求める。w の先頭が切片、残りが係数になる。
●(特徴量一覧と実測一覧を列名一覧で)線形回帰学習とは
    もし、(特徴量一覧の要素数) = 0ならば
        「訓練データが空です」のエラー発生
    ここまで
    もし、(特徴量一覧の要素数) ≠ (実測一覧の要素数)ならば
        「特徴量と実測値の件数が違います: {特徴量一覧の要素数} と {実測一覧の要素数}」のエラー発生
    ここまで
    計画行列 = 特徴量一覧と列名一覧の計画行列作成
    転置行列 = 計画行列を行列転置
    正規行列 = 転置行列と計画行列の行列積算
    # Xᵀ t は、t を 1 列の行列にして掛ける。
    実測列 = []
    Iを 0から (実測一覧の要素数) - 1まで繰り返す
        実測列に[実測一覧[I]]を配列追加
    ここまで
    右辺行列 = 転置行列と実測列の行列積算
    右辺一覧 = []
    Iを 0から (右辺行列の要素数) - 1まで繰り返す
        右辺一覧に(右辺行列[I][0])を配列追加
    ここまで
    重み一覧 = 正規行列と右辺一覧を連立一次方程式求解
    係数一覧 = []
    Iを 1から (重み一覧の要素数) - 1まで繰り返す
        係数一覧に(重み一覧[I])を配列追加
    ここまで
    (重み一覧[0])と列名一覧を係数一覧で線形回帰モデル作成して戻る
ここまで

# SNS2 が大きく、それなのに興行収入が小さい行を外れ値とする。空欄なら外れ値ではない。
●(行の)映画外れ値判定とは
    反響 = 行の「SNS2」を欠損許容数値取得
    収入 = 行の映画目的列を欠損許容数値取得
    もし、(反響 === NULL)または(収入 === NULL)ならば
        偽で戻る
    ここまで
    もし、(反響 > 映画外れ値反響下限)かつ(収入 < 映画外れ値収入上限)ならば
        真で戻る
    ここまで
    偽で戻る
ここまで

# 外れ値の行を除いた新しい表を返す。列はそのまま残し、元の表は書き換えない。
●(対象表の)映画外れ値除去とは
    行一覧 = 対象表["行一覧"]
    残す行一覧 = []
    Iを 0から (行一覧の要素数) - 1まで繰り返す
        もし、(行一覧[I]の映画外れ値判定) = 偽ならば
            残す行一覧に(行一覧[I])を配列追加
        ここまで
    ここまで
    {"列名一覧": 対象表["列名一覧"], "行一覧": 残す行一覧}で戻る
ここまで

# 正解ラベルを数値にする。数値として読めなければ、空欄ならエラーを起こす。
●(ラベル一覧の)映画目的値変換とは
    結果 = []
    Iを 0から (ラベル一覧の要素数) - 1まで繰り返す
        行 = {}
        行[映画目的列] = ラベル一覧[I]
        値 = 行の映画目的列を欠損許容数値取得
        もし、値 === NULLならば
            「{映画目的列} が空欄です」のエラー発生
        ここまで
        結果に値を配列追加
    ここまで
    結果で戻る
ここまで

# cinema.csv の中身を読み込み、外れ値を除き、分割してから訓練データの平均値で両方を補完する。
# 順番が大事で、外れ値を除いてから分割し、訓練データだけから平均を求める。
# テストデータの平均を混ぜると、テストデータの情報が訓練に漏れる。
●(CSV文字列を割合とシードで)映画前処理とは
    読込表 = CSV文字列を表読込
    除去表 = 読込表の映画外れ値除去
    分離結果 = 除去表と映画目的列の目的列分離
    分割結果 = (分離結果["行一覧"])と(分離結果["正解ラベル"])を割合とシードで訓練テスト分割
    平均一覧 = (分割結果["訓練特徴量"])と映画特徴量列の列平均算出
    分割結果["訓練特徴量"] = (分割結果["訓練特徴量"])と映画特徴量列を平均一覧で欠損補完
    分割結果["テスト特徴量"] = (分割結果["テスト特徴量"])と映画特徴量列を平均一覧で欠損補完
    分割結果で戻る
ここまで

# 読み込んだ中身から報告の文字列を作る。ファイルを読まないので、テストで確かめられる。
●(CSV文字列を)映画回帰報告作成とは
    読込表 = CSV文字列を表読込
    除去表 = 読込表の映画外れ値除去
    前処理結果 = CSV文字列を0.2と0で映画前処理
    訓練実測 = (前処理結果["訓練正解"])の映画目的値変換
    テスト実測 = (前処理結果["テスト正解"])の映画目的値変換
    モデル = (前処理結果["訓練特徴量"])と訓練実測を映画特徴量列で線形回帰学習
    予測一覧 = モデルで(前処理結果["テスト特徴量"])を線形回帰予測
    決定係数表示 = (テスト実測と予測一覧の決定係数算出)を4で小数表示
    誤差表示 = (テスト実測と予測一覧の平均絶対誤差算出)を2で小数表示
    平方根誤差表示 = (テスト実測と予測一覧の二乗平均平方根誤差算出)を2で小数表示
    件数 = 読込表["行一覧"]の要素数
    残件数 = 除去表["行一覧"]の要素数
    訓練件数 = 前処理結果["訓練特徴量"]の要素数
    テスト件数 = 前処理結果["テスト特徴量"]の要素数
    切片表示 = (モデル["切片"])を2で小数表示
    係数表示 = モデルの回帰係数表示
    「データ件数: {件数}{改行}外れ値を除いた件数: {残件数}{改行}訓練データ: {訓練件数} 件, テストデータ: {テスト件数} 件{改行}切片: {切片表示}{改行}係数: {係数表示}{改行}テストデータの評価: R2={決定係数表示}, MAE={誤差表示}, RMSE={平方根誤差表示}{改行}」で戻る
ここまで

