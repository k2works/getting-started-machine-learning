# 第 13 章: 主成分分析による次元削減。
#
# 中心化・分散共分散行列・固有値分解・符号・射影・寄与率をすべて自作する。
# なでしこ3 には行列の命令が無いので、固有値分解もヤコビ法で自作し、これが最終実装になる。
# 行列は「長さのそろった数値の配列」を並べた配列で表す。

!「./csv.nako3」を取り込む
!「./chapter02.nako3」を取り込む
!「./dataset.nako3」を取り込む
!「./number_format.nako3」を取り込む

# カテゴリ値の列。
主成分カテゴリ列 = 「CRIME」
# 何割のばらつきを説明できれば十分とみなすか。
寄与率閾値 = 0.8
# 主成分ごとに表示する列の数。
影響列表示数 = 3
# 意味を読む主成分の数。
解釈主成分数 = 2
# ヤコビ法の掃き出しの回数の上限。15×15 なら 10 巡もあれば収束する（Haskell 版と同じ）。
ヤコビ最大巡回数 = 100
# 非対角成分の 2 乗和がこれを下回ったら対角行列とみなす（Haskell 版と同じ）。
ヤコビ打切値 = 1e-30

# 中心化と分散共分散行列 -----------------------------------------------------

# 列ごとの平均を返す。
●(データ行列の)主成分列平均とは
    結果 = []
    もし、(データ行列の要素数) = 0ならば
        結果で戻る
    ここまで
    件数 = データ行列の要素数
    Jを 0から (データ行列[0]の要素数) - 1まで繰り返す
        和 = 0
        Iを 0から 件数 - 1まで繰り返す
            和 = 和 + データ行列[I][J]
        ここまで
        結果に(和 ÷ 件数)を配列追加
    ここまで
    結果で戻る
ここまで

# 各列から平均を引く（中心化）。元の行列は書き換えず、新しい行列を返す。
●(データ行列を平均一覧で)主成分中心化とは
    結果 = []
    Iを 0から (データ行列の要素数) - 1まで繰り返す
        行 = []
        Jを 0から (平均一覧の要素数) - 1まで繰り返す
            行に(データ行列[I][J] - 平均一覧[J])を配列追加
        ここまで
        結果に行を配列追加
    ここまで
    結果で戻る
ここまで

# 内積。左から順に足す。
●(左ベクトルと右ベクトルの)主成分内積とは
    和 = 0
    Iを 0から (左ベクトルの要素数) - 1まで繰り返す
        和 = 和 + 左ベクトル[I] × 右ベクトル[I]
    ここまで
    和で戻る
ここまで

# 列ごとの分散と、2 列ずつの共分散を並べた行列。件数から 1 を引いた数で割る。
# 寄与率は「固有値 ÷ 固有値の合計」なので割る数は結論に影響しないが、
# ほかの言語版と分散そのものの値をそろえるため n−1 にする。
●(データ行列の)分散共分散行列算出とは
    件数 = データ行列の要素数
    もし、件数 < 2ならば
        「主成分分析には 2 件以上のデータが必要です（{件数} 件）」のエラー発生
    ここまで
    中心化行列 = データ行列を(データ行列の主成分列平均)で主成分中心化
    # 列を 1 本ずつ取り出して、列どうしの内積を取る。
    列一覧 = []
    Jを 0から (中心化行列[0]の要素数) - 1まで繰り返す
        列 = []
        Iを 0から 件数 - 1まで繰り返す
            列に中心化行列[I][J]を配列追加
        ここまで
        列一覧に列を配列追加
    ここまで
    結果 = []
    Aを 0から (列一覧の要素数) - 1まで繰り返す
        行 = []
        Bを 0から (列一覧の要素数) - 1まで繰り返す
            行に((列一覧[A]と列一覧[B]の主成分内積) ÷ (件数 - 1))を配列追加
        ここまで
        結果に行を配列追加
    ここまで
    結果で戻る
ここまで

# 固有値分解 -----------------------------------------------------------------

# 正方かつ対称かを確かめる。そうでなければエラーを起こす。
●(対象行列の)固有値分解前検査とは
    次数 = 対象行列の要素数
    Iを 0から 次数 - 1まで繰り返す
        もし、(対象行列[I]の要素数) ≠ 次数ならば
            「正方行列ではありません: {次数} 行」のエラー発生
        ここまで
    ここまで
    Iを 0から 次数 - 1まで繰り返す
        Jを 0から 次数 - 1まで繰り返す
            もし、対象行列[I][J] ≠ 対象行列[J][I]ならば
                「固有値分解できません（対称行列ではありません）」のエラー発生
            ここまで
        ここまで
    ここまで
ここまで

# 非対角成分の 2 乗和。行の順に足す。
●(対象行列の)非対角二乗和とは
    和 = 0
    Iを 0から (対象行列の要素数) - 1まで繰り返す
        Jを 0から (対象行列の要素数) - 1まで繰り返す
            もし、I ≠ Jならば
                和 = 和 + 対象行列[I][J] × 対象行列[I][J]
            ここまで
        ここまで
    ここまで
    和で戻る
ここまで

# (P, Q) 成分を 0 にする 2 次元の回転を、作業行列と固有ベクトルの行列の両方に掛ける。
# 2 つの行列をその場で書き換える（呼ぶ側で複製したものを渡す）。
# 正接は絶対値の小さいほうの根を選ぶ。素直に解の公式を書くと、角度の比が
# 大きいときに近い数どうしの引き算になって桁落ちする。
●(作業行列と固有列行列をPとQで)ヤコビ回転とは
    APQ = 作業行列[P][Q]
    もし、APQ = 0ならば
        戻る
    ここまで
    APP = 作業行列[P][P]
    AQQ = 作業行列[Q][Q]
    角度比 = (AQQ - APP) ÷ (2 × APQ)
    回転符号 = 1
    もし、角度比 < 0ならば
        回転符号 = -1
    ここまで
    正接 = 回転符号 ÷ ((角度比の絶対値) + ((角度比 × 角度比 + 1)の平方根))
    余弦 = 1 ÷ ((正接 × 正接 + 1)の平方根)
    正弦 = 正接 × 余弦
    次数 = 作業行列の要素数
    Kを 0から 次数 - 1まで繰り返す
        もし、(K ≠ P) かつ (K ≠ Q)ならば
            KP値 = 余弦 × 作業行列[K][P] - 正弦 × 作業行列[K][Q]
            KQ値 = 正弦 × 作業行列[K][P] + 余弦 × 作業行列[K][Q]
            作業行列[K][P] = KP値
            作業行列[P][K] = KP値
            作業行列[K][Q] = KQ値
            作業行列[Q][K] = KQ値
        ここまで
    ここまで
    作業行列[P][P] = APP - 正接 × APQ
    作業行列[Q][Q] = AQQ + 正接 × APQ
    作業行列[P][Q] = 0
    作業行列[Q][P] = 0
    Kを 0から 次数 - 1まで繰り返す
        VKP値 = 余弦 × 固有列行列[K][P] - 正弦 × 固有列行列[K][Q]
        VKQ値 = 正弦 × 固有列行列[K][P] + 余弦 × 固有列行列[K][Q]
        固有列行列[K][P] = VKP値
        固有列行列[K][Q] = VKQ値
    ここまで
ここまで

# 固有値の大きい順に、固有値と固有ベクトルの組を並べ替える。
# 挿入ソートで、より大きいときだけ前へ動かすので、同じ固有値なら元の順が残る。
●(固有値一覧と固有ベクトル一覧の)固有値降順並替とは
    順番 = []
    Iを 0から (固有値一覧の要素数) - 1まで繰り返す
        位置 = 順番の要素数
        (位置 > 0)の間
            もし、固有値一覧[I] > 固有値一覧[順番[位置 - 1]]ならば
                位置 = 位置 - 1
            違えば
                抜ける
            ここまで
        ここまで
        順番の位置にIを配列挿入
    ここまで
    値結果 = []
    ベクトル結果 = []
    Iを 0から (順番の要素数) - 1まで繰り返す
        値結果に固有値一覧[順番[I]]を配列追加
        ベクトル結果に固有ベクトル一覧[順番[I]]を配列追加
    ここまで
    {"固有値": 値結果, "固有ベクトル": ベクトル結果}で戻る
ここまで

# 対称行列をヤコビ法で固有値分解し、固有値と固有ベクトル（1 行に 1 つ）を大きい順に返す。
# 上三角の非対角成分を順に 2 次元の回転で 0 にしていき、非対角成分の 2 乗和が
# 打ち切りの値を下回るまで（上限はヤコビ最大巡回数）何巡もする。
# 回転を掛け合わせた行列の列が固有ベクトルになる。掃き出しの回数と、
# 打ち切ったときの非対角成分の 2 乗和も返す。
●(対称行列の)ヤコビ固有値分解とは
    対称行列の固有値分解前検査
    次数 = 対称行列の要素数
    作業行列 = []
    固有列行列 = []
    Iを 0から 次数 - 1まで繰り返す
        作業行 = []
        単位行 = []
        Jを 0から 次数 - 1まで繰り返す
            作業行に対称行列[I][J]を配列追加
            もし、I = Jならば
                単位行に1を配列追加
            違えば
                単位行に0を配列追加
            ここまで
        ここまで
        作業行列に作業行を配列追加
        固有列行列に単位行を配列追加
    ここまで
    巡回数 = 0
    (巡回数 < ヤコビ最大巡回数)の間
        もし、(作業行列の非対角二乗和) < ヤコビ打切値ならば
            抜ける
        ここまで
        Pを 0から 次数 - 2まで繰り返す
            Qを (P + 1)から 次数 - 1まで繰り返す
                作業行列と固有列行列をPとQでヤコビ回転
            ここまで
        ここまで
        巡回数 = 巡回数 + 1
    ここまで
    固有値一覧 = []
    固有ベクトル一覧 = []
    Iを 0から 次数 - 1まで繰り返す
        固有値一覧に作業行列[I][I]を配列追加
        # 固有ベクトルは列に並ぶので、列を取り出して 1 行に 1 つずつにする。
        ベクトル = []
        Kを 0から 次数 - 1まで繰り返す
            ベクトルに固有列行列[K][I]を配列追加
        ここまで
        固有ベクトル一覧にベクトルを配列追加
    ここまで
    結果 = 固有値一覧と固有ベクトル一覧の固有値降順並替
    結果["掃き出し回数"] = 巡回数
    結果["非対角二乗和"] = 作業行列の非対角二乗和
    結果で戻る
ここまで

# 固有ベクトルは符号が逆でも同じ向きを表すので、絶対値が最大の要素が正になるようにそろえる。
# 絶対値が同じなら前の要素を見る（厳密な > で比べる）。元の配列は書き換えない。
●(ベクトル一覧の)固有ベクトル符号整列とは
    結果 = []
    Iを 0から (ベクトル一覧の要素数) - 1まで繰り返す
        ベクトル = ベクトル一覧[I]
        最大要素 = 0
        Jを 0から (ベクトルの要素数) - 1まで繰り返す
            もし、(ベクトル[J]の絶対値) > (最大要素の絶対値)ならば
                最大要素 = ベクトル[J]
            ここまで
        ここまで
        新ベクトル = []
        Jを 0から (ベクトルの要素数) - 1まで繰り返す
            もし、最大要素 < 0ならば
                新ベクトルに(0 - ベクトル[J])を配列追加
            違えば
                新ベクトルにベクトル[J]を配列追加
            ここまで
        ここまで
        結果に新ベクトルを配列追加
    ここまで
    結果で戻る
ここまで

# 主成分分析 -----------------------------------------------------------------

# 分散共分散行列をヤコビ法で固有値分解し、寄与率の大きい順に主成分を求める。
# 返す辞書は、平均・主成分（1 行に 1 つ）・分散（固有値）・寄与率・掃き出し回数。
●(データ行列を主成分数で)主成分分析学習とは
    共分散結果 = データ行列の分散共分散行列算出
    分解結果 = 共分散結果のヤコビ固有値分解
    固有値一覧 = 分解結果["固有値"]
    列数 = 固有値一覧の要素数
    もし、(主成分数 < 1) または (主成分数 > 列数)ならば
        「主成分の数は 1 以上 {列数} 以下にしてください: {主成分数}」のエラー発生
    ここまで
    総和 = 0
    Iを 0から 列数 - 1まで繰り返す
        総和 = 総和 + 固有値一覧[I]
    ここまで
    選択ベクトル = []
    分散一覧 = []
    寄与率一覧 = []
    Iを 0から 主成分数 - 1まで繰り返す
        選択ベクトルに(分解結果["固有ベクトル"])[I]を配列追加
        分散一覧に固有値一覧[I]を配列追加
        寄与率一覧に(固有値一覧[I] ÷ 総和)を配列追加
    ここまで
    {"平均": データ行列の主成分列平均, "主成分": 選択ベクトルの固有ベクトル符号整列, "分散": 分散一覧, "寄与率": 寄与率一覧, "掃き出し回数": 分解結果["掃き出し回数"]}で戻る
ここまで

# 平均を引いてから、データを主成分の向きに射影する。
●(モデルでデータ行列を)主成分射影とは
    中心化行列 = データ行列を(モデル["平均"])で主成分中心化
    主成分一覧 = モデル["主成分"]
    結果 = []
    Iを 0から (中心化行列の要素数) - 1まで繰り返す
        行 = []
        Kを 0から (主成分一覧の要素数) - 1まで繰り返す
            行に(中心化行列[I]と主成分一覧[K]の主成分内積)を配列追加
        ここまで
        結果に行を配列追加
    ここまで
    結果で戻る
ここまで

# 主成分の数と解釈 -----------------------------------------------------------

# 累積寄与率がしきい値に届くまでの主成分の数。届かなければすべての主成分の数。
●(寄与率一覧を閾値で)必要主成分数算出とは
    累積 = 0
    Iを 0から (寄与率一覧の要素数) - 1まで繰り返す
        累積 = 累積 + 寄与率一覧[I]
        もし、累積 ≧ 閾値ならば
            (I + 1)で戻る
        ここまで
    ここまで
    寄与率一覧の要素数で戻る
ここまで

# 主成分の係数の絶対値が大きい順に、[列名, 係数] を個数だけ返す。
# 挿入ソートで、より大きいときだけ前へ動かすので、絶対値が同じなら元の列の順が残る。
●(主成分と列名一覧を個数で)主成分影響列抽出とは
    順番 = []
    Iを 0から (主成分の要素数) - 1まで繰り返す
        位置 = 順番の要素数
        (位置 > 0)の間
            もし、(主成分[I]の絶対値) > (主成分[順番[位置 - 1]]の絶対値)ならば
                位置 = 位置 - 1
            違えば
                抜ける
            ここまで
        ここまで
        順番の位置にIを配列挿入
    ここまで
    取出数 = 個数
    もし、(順番の要素数) < 取出数ならば
        取出数 = 順番の要素数
    ここまで
    結果 = []
    Iを 0から 取出数 - 1まで繰り返す
        結果に[列名一覧[順番[I]], 主成分[順番[I]]]を配列追加
    ここまで
    結果で戻る
ここまで

# ボストンの住宅価格 ---------------------------------------------------------

# カテゴリの一覧。空欄を除き、重複を除いて文字の順に並べ、最初の 1 つを落とす（基準にする）。
●(値一覧の)ボストンカテゴリ列挙とは
    既出 = {}
    種類一覧 = []
    Iを 0から (値一覧の要素数) - 1まで繰り返す
        値 = (値一覧[I])をトリム
        もし、(値 !== 「」) かつ ((既出の値がハッシュキー存在) = 偽)ならば
            既出[値] = 真
            種類一覧に値を配列追加
        ここまで
    ここまで
    種類一覧 = 種類一覧の配列ソート
    結果 = []
    Iを 1から (種類一覧の要素数) - 1まで繰り返す
        結果に種類一覧[I]を配列追加
    ここまで
    結果で戻る
ここまで

# カテゴリの列を取り除き、カテゴリごとに「列名_カテゴリ」の列を末尾に加える。
# 値が一致すれば 1、それ以外は 0。元の表は書き換えない。
●(対象表を列名で)ボストンダミー変数化とは
    行一覧 = 対象表["行一覧"]
    値一覧 = []
    Iを 0から (行一覧の要素数) - 1まで繰り返す
        値一覧に(行一覧[I]の列名を列取得)を配列追加
    ここまで
    種類一覧 = 値一覧のボストンカテゴリ列挙
    新列名一覧 = []
    元列名一覧 = 対象表["列名一覧"]
    Iを 0から (元列名一覧の要素数) - 1まで繰り返す
        もし、元列名一覧[I] ≠ 列名ならば
            新列名一覧に元列名一覧[I]を配列追加
        ここまで
    ここまで
    Iを 0から (種類一覧の要素数) - 1まで繰り返す
        新列名一覧に「{列名}_{種類一覧[I]}」を配列追加
    ここまで
    新行一覧 = []
    Iを 0から (行一覧の要素数) - 1まで繰り返す
        新行 = {}
        Jを 0から (元列名一覧の要素数) - 1まで繰り返す
            もし、元列名一覧[J] ≠ 列名ならば
                新行[元列名一覧[J]] = 行一覧[I][元列名一覧[J]]
            ここまで
        ここまで
        Jを 0から (種類一覧の要素数) - 1まで繰り返す
            もし、値一覧[I] = 種類一覧[J]ならば
                新行[「{列名}_{種類一覧[J]}」] = 1
            違えば
                新行[「{列名}_{種類一覧[J]}」] = 0
            ここまで
        ここまで
        新行一覧に新行を配列追加
    ここまで
    {"列名一覧": 新列名一覧, "行一覧": 新行一覧}で戻る
ここまで

# 特徴量（列名から数値への辞書）の配列を、列ごとに平均 0・標準偏差 1 にそろえる。
# 標準偏差は件数で割る。標準偏差が 0 の列は 1 とみなす。元の配列は書き換えない。
●(特徴量一覧と列名一覧の)ボストン標準化とは
    件数 = 特徴量一覧の要素数
    平均一覧 = {}
    偏差一覧 = {}
    Jを 0から (列名一覧の要素数) - 1まで繰り返す
        列名 = 列名一覧[J]
        和 = 0
        Iを 0から 件数 - 1まで繰り返す
            和 = 和 + 特徴量一覧[I][列名]
        ここまで
        平均 = 和 ÷ 件数
        二乗和 = 0
        Iを 0から 件数 - 1まで繰り返す
            二乗和 = 二乗和 + (特徴量一覧[I][列名] - 平均) × (特徴量一覧[I][列名] - 平均)
        ここまで
        偏差 = (二乗和 ÷ 件数)の平方根
        もし、偏差 = 0ならば
            偏差 = 1
        ここまで
        平均一覧[列名] = 平均
        偏差一覧[列名] = 偏差
    ここまで
    結果 = []
    Iを 0から 件数 - 1まで繰り返す
        新特徴量 = {}
        Jを 0から (列名一覧の要素数) - 1まで繰り返す
            列名 = 列名一覧[J]
            新特徴量[列名] = (特徴量一覧[I][列名] - 平均一覧[列名]) ÷ 偏差一覧[列名]
        ここまで
        結果に新特徴量を配列追加
    ここまで
    結果で戻る
ここまで

# 特徴量の配列を、列名一覧の順に値を並べた行列にする（辞書の順に頼らない）。
●(特徴量一覧と列名一覧の)主成分行列変換とは
    結果 = []
    Iを 0から (特徴量一覧の要素数) - 1まで繰り返す
        行 = []
        Jを 0から (列名一覧の要素数) - 1まで繰り返す
            行に特徴量一覧[I][列名一覧[J]]を配列追加
        ここまで
        結果に行を配列追加
    ここまで
    結果で戻る
ここまで

# CSV の文字列を読み、CRIME をダミー変数にし、欠損値を列の平均値で補完してから、
# すべての列を標準化した行列にする。列名一覧と行列を返す。
●(CSV文字列の)ボストン行列読込とは
    読込表 = CSV文字列を表読込
    変換表 = 読込表を主成分カテゴリ列でボストンダミー変数化
    列名一覧 = 変換表["列名一覧"]
    行一覧 = 変換表["行一覧"]
    平均一覧 = 行一覧と列名一覧の列平均算出
    補完済 = 行一覧と列名一覧を平均一覧で欠損補完
    標準化済 = 補完済と列名一覧のボストン標準化
    {"列名一覧": 列名一覧, "行列": 標準化済と列名一覧の主成分行列変換}で戻る
ここまで

# 主成分の意味を、係数の大きい列から読んで 1 行にする。
●(主成分と列名一覧を番号で)主成分解釈行作成とは
    影響一覧 = 主成分と列名一覧を影響列表示数で主成分影響列抽出
    表示一覧 = []
    Iを 0から (影響一覧の要素数) - 1まで繰り返す
        表示一覧に「{影響一覧[I][0]} {(影響一覧[I][1])を3で小数表示}」を配列追加
    ここまで
    「第 {番号} 主成分で影響の大きい列: {表示一覧を『, 』で配列結合}」で戻る
ここまで

# 読み込んだ中身から報告の文字列を作る。ファイルを読まないので、テストで確かめられる。
●(CSV文字列を)主成分分析報告作成とは
    読込結果 = CSV文字列のボストン行列読込
    列名一覧 = 読込結果["列名一覧"]
    データ行列 = 読込結果["行列"]
    モデル = データ行列を(列名一覧の要素数)で主成分分析学習
    寄与率一覧 = モデル["寄与率"]
    必要数 = 寄与率一覧を寄与率閾値で必要主成分数算出
    累積 = 0
    寄与率表示 = []
    Iを 0から 必要数 - 1まで繰り返す
        累積 = 累積 + 寄与率一覧[I]
        寄与率表示に「PC{I + 1} {(寄与率一覧[I])を4で小数表示}」を配列追加
    ここまで
    行一覧 = []
    行一覧に「データ件数: {データ行列の要素数}, 列数: {列名一覧の要素数}」を配列追加
    行一覧に「寄与率: {寄与率表示を『, 』で配列結合}」を配列追加
    行一覧に「累積寄与率が {寄与率閾値} に届く主成分の数: {必要数}（累積寄与率 {累積を4で小数表示}）」を配列追加
    Iを 0から 解釈主成分数 - 1まで繰り返す
        行一覧に((モデル["主成分"])[I]と列名一覧を(I + 1)で主成分解釈行作成)を配列追加
    ここまで
    行一覧に「ヤコビ法の掃き出し: {モデル["掃き出し回数"]} 巡」を配列追加
    (行一覧を改行で配列結合) & 改行で戻る
ここまで

